sppc:iet-deferred-to-commit a skos:Concept ;
    skos:definition "The invariant is checked at transaction commit boundary; intermediate states within the transaction may violate it transiently."@en ;
    skos:inScheme sppc:invariant-enforcement-timing ;
    skos:prefLabel "deferred_to_commit"@en .

sppc:iet-eager a skos:Concept ;
    skos:definition "The invariant is checked immediately at the point of every mutation, before the mutation is permitted."@en ;
    skos:inScheme sppc:invariant-enforcement-timing ;
    skos:prefLabel "eager"@en .

sppc:iet-eventually-consistent a skos:Concept ;
    skos:definition "The invariant is checked asynchronously; violations are detected and reconciled later. Used when eager/commit enforcement is infeasible (cross-aggregate, cross-tenant)."@en ;
    skos:inScheme sppc:invariant-enforcement-timing ;
    skos:prefLabel "eventually_consistent"@en .

sppc:igs-external a skos:Concept ;
    skos:definition "Identifier supplied by an external system (e.g. payment-provider reference). The local system does not generate the value."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "external"@en .

sppc:igs-ksuid a skos:Concept ;
    skos:definition "K-Sortable Unique IDentifier. 160-bit time-prefixed, Base62 encoded."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "ksuid"@en .

sppc:igs-prefixed-sequence a skos:Concept ;
    skos:definition "Monotonic sequence with a type prefix (e.g. `inv_000123`). Server- or database-issued; human-readable; not globally unique without coordination."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "prefixed_sequence"@en .

sppc:igs-ulid a skos:Concept ;
    skos:definition "Universally Unique Lexicographically Sortable Identifier. 128-bit time-prefixed, Crockford Base32 encoded."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "ulid"@en .

sppc:igs-user-supplied a skos:Concept ;
    skos:definition "Identifier supplied by the API caller as part of the create-command payload. Useful for idempotent client-driven creation."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "user_supplied"@en .

sppc:igs-uuid-v4 a skos:Concept ;
    skos:definition "Random UUID per RFC 4122 version 4. Non-sortable; high collision resistance."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "uuid_v4"@en .

sppc:igs-uuid-v7 a skos:Concept ;
    skos:definition "Time-ordered UUID per RFC 9562 version 7. Lexicographically sortable by creation time; database-index-friendly."@en ;
    skos:inScheme sppc:id-generation-strategy ;
    skos:prefLabel "uuid_v7"@en .

