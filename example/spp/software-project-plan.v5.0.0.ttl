spp:commandPostcondition a owl:DatatypeProperty ;
    rdfs:domain spp:Command ;
    rdfs:range xsd:string .

spp:commandPrecondition a owl:DatatypeProperty ;
    rdfs:comment "Hoare-style precondition expression. Grammar declared at component scope."@en ;
    rdfs:domain spp:Command ;
    rdfs:range xsd:string .

spp:commandResultKind a owl:ObjectProperty ;
    rdfs:domain spp:Command ;
    rdfs:range skos:Concept .

spp:commandRule a owl:DatatypeProperty ;
    rdfs:comment """Inline BSL (or other planBehaviorGrammar) rule. When
        present, satisfies the strict-profile behavior requirement without
        requiring separate pre+post conditions."""@en ;
    rdfs:range xsd:string .

spp:commandSyntheticError a owl:ObjectProperty ;
    rdfs:comment "Synthetic-error-key concept(s) that this command may emit. Closure analogue: backend-spec L19."@en ;
    rdfs:domain spp:Command ;
    rdfs:range skos:Concept .

