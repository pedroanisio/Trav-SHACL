    skos:inScheme sppc:requirements-alpha-state ;
    skos:prefLabel "Conceived"@en .

sppc:req-fulfilled a skos:Concept ;
    skos:inScheme sppc:requirements-alpha-state ;
    skos:prefLabel "Fulfilled"@en .

sppc:result-accepted-async a skos:Concept ;
    skos:inScheme sppc:command-result-kind ;
    skos:prefLabel "accepted_async"@en .

sppc:result-entity a skos:Concept ;
    skos:inScheme sppc:command-result-kind ;
    skos:prefLabel "entity"@en .

sppc:result-id-only a skos:Concept ;
    skos:inScheme sppc:command-result-kind ;
    skos:prefLabel "id_only"@en .

