sppc:tk-amqp a skos:Concept ;
    skos:definition "AMQP 0-9-1 or AMQP 1.0 messaging transport. RabbitMQ is the most common implementation."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "amqp"@en .

sppc:tk-cli a skos:Concept ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "Command-line invocation (argv + stdio)"@en .

sppc:tk-graphql a skos:Concept ;
    skos:definition "GraphQL transport (typically over HTTP POST, optionally with subscriptions over WebSocket)."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "graphql"@en .

sppc:tk-grpc a skos:Concept ;
    skos:definition "gRPC over HTTP/2. Includes unary, server-streaming, client-streaming, and bidirectional-streaming method types."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "grpc"@en .

sppc:tk-http a skos:Concept ;
    skos:definition "HTTP/1.1 or HTTP/2 transport. Most REST APIs and many gRPC and GraphQL deployments use HTTP as the underlying transport."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "http"@en .

sppc:tk-kafka a skos:Concept ;
    skos:definition "Apache Kafka wire protocol — partitioned, replicated, append-only log transport."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "kafka"@en .

sppc:tk-library a skos:Concept ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "In-process library API (function calls)"@en .

sppc:tk-nats a skos:Concept ;
    skos:definition "NATS messaging protocol — lightweight subject-based pub/sub with optional JetStream persistence."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "nats"@en .

sppc:tk-rpc-in-process a skos:Concept ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "In-process RPC (e.g. Web Workers)"@en .

sppc:tk-sse a skos:Concept ;
    skos:definition "Server-Sent Events — HTTP-based unidirectional server-to-client streaming."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "sse"@en .

sppc:tk-stdio a skos:Concept ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "Standard input/output streams"@en .

sppc:tk-websocket a skos:Concept ;
    skos:definition "RFC 6455 WebSocket — bidirectional full-duplex transport upgraded from HTTP."@en ;
    skos:inScheme sppc:transport-kind ;
    skos:prefLabel "websocket"@en .

