sppc:data-relation-cardinality a skos:ConceptScheme ;
    dcterms:title "Data Relation Cardinality"@en ;
    rdfs:comment "UML association multiplicities. The 1:1 / 1:N / N:M tripartition is canonical and formally defined."@en ;
    skos:hasTopConcept sppc:dc-many-to-many,
        sppc:dc-one-to-many,
        sppc:dc-one-to-one,
        sppc:dc-zero-or-one,
