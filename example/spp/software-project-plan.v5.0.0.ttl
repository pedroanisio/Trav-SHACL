    spp:groundedIn sppsrc:nygard-2018,
        sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PARTIALLY_GROUNDED ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T2 .

sppc:sbom-policy a skos:ConceptScheme ;
