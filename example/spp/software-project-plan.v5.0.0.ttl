spp:transitionFrom a owl:ObjectProperty ;
    rdfs:domain spp:Transition ;
    rdfs:range skos:Concept .

spp:transitionTo a owl:ObjectProperty ;
    rdfs:domain spp:Transition ;
    rdfs:range skos:Concept .

spp:transitionTrigger a owl:ObjectProperty ;
    rdfs:comment "Either a spp:Command or a spp:Event. Cross-shape SHACL rule §11.21 enforces resolution."@en ;
    rdfs:domain spp:Transition ;
    rdfs:range owl:Thing .

spp:transportBaseUrl a owl:DatatypeProperty ;
    rdfs:domain spp:Transport ;
    rdfs:range xsd:anyURI .

spp:transportDefaultWireFormat a owl:ObjectProperty ;
    rdfs:domain spp:Transport ;
    rdfs:range spp:WireFormat .

spp:transportKind a owl:DatatypeProperty ;
    rdfs:domain spp:Transport ;
    rdfs:range xsd:string .

spp:transportName a owl:DatatypeProperty ;
    rdfs:domain spp:Transport ;
    rdfs:range xsd:string .

spp:transportVersion a owl:DatatypeProperty ;
    rdfs:domain spp:Transport ;
    rdfs:range xsd:string .

spp:typeDecl a owl:ObjectProperty ;
    rdfs:domain spp:Component ;
    rdfs:range spp:TypeDecl .

spp:versioningScheme a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range skos:Concept .

spp:visibility a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range skos:Concept .

spp:wayOfWorkingAlphaState a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range skos:Concept .

spp:wireFormatEnvelope a owl:DatatypeProperty ;
    rdfs:domain spp:WireFormat ;
    rdfs:range xsd:string .

spp:wireFormatKind a owl:DatatypeProperty ;
    rdfs:domain spp:WireFormat ;
    rdfs:range xsd:string .

spp:wireFormatName a owl:DatatypeProperty ;
    rdfs:domain spp:WireFormat ;
    rdfs:range xsd:string .

spp:wireFormatSchemaLink a owl:DatatypeProperty ;
    rdfs:domain spp:WireFormat ;
    rdfs:range xsd:anyURI .

spp:workAlphaState a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range skos:Concept .

sppsh:PublicallyReadablePlanRequiresPrivacyAndSbomShape a sh:NodeShape ;
    sh:property [ sh:message "A plan with public or open-source visibility MUST declare privacyPosture."@en ;
            sh:minCount 1 ;
            sh:path spp:privacyPosture ;
            sh:severity sh:Violation ],
        [ sh:message "A plan with public or open-source visibility MUST declare sbomPolicy."@en ;
            sh:minCount 1 ;
            sh:path spp:sbomPolicy ;
            sh:severity sh:Violation ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX spp:  <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT ?this WHERE {
                ?this rdf:type spp:SoftwareProjectPlan .
                ?this spp:visibility ?vis .
                FILTER (?vis IN (sppc:vis-public, sppc:vis-open-source))
            }
        """ ] .

