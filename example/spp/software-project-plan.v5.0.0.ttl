    skos:prefLabel "Waterfall"@en .

sppc:proc-xp a skos:Concept ;
    skos:inScheme sppc:process-methodology ;
    skos:prefLabel "Extreme Programming (XP)"@en .

sppc:ps-cursor a skos:Concept ;
    skos:definition "Opaque-cursor pagination — the client carries an opaque server-issued token; resilient to inserts during traversal."@en ;
    skos:inScheme sppc:pagination-style ;
    skos:prefLabel "cursor"@en .

sppc:ps-none a skos:Concept ;
    skos:definition "No pagination — the query returns the full result set, bounded only by max-page-size constraints if any."@en ;
    skos:inScheme sppc:pagination-style ;
    skos:prefLabel "none"@en .

sppc:ps-offset a skos:Concept ;
    skos:definition "Offset/limit pagination — the client specifies offset and limit. Cheap to implement; loses results on concurrent inserts."@en ;
    skos:inScheme sppc:pagination-style ;
    skos:prefLabel "offset"@en .

