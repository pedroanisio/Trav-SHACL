    rdfs:comment """Parameters specific to the guard kind. By convention a JSON
        literal; the meta-schema does not validate its structure. Example for
        budget_gate: '{"max_files": 1000}'. Example for rate_limit:
        '{"capacity": 100, "refill_per_second": 10}'."""@en ;
