sppc:rb-automatic a skos:Concept ;
    skos:inScheme sppc:rollback-policy ;
    skos:prefLabel "Automatic on failure signal"@en .

sppc:rb-exponential a skos:Concept ;
    skos:definition "Exponentially increasing delay between retry attempts; typically combined with jitter to avoid thundering-herd retries."@en ;
    skos:inScheme sppc:retry-backoff ;
    skos:prefLabel "exponential"@en .

sppc:rb-fixed a skos:Concept ;
    skos:definition "Constant delay between retry attempts."@en ;
    skos:inScheme sppc:retry-backoff ;
    skos:prefLabel "fixed"@en .

sppc:rb-forward-only a skos:Concept ;
    skos:inScheme sppc:rollback-policy ;
    skos:prefLabel "Forward-only (no rollback)"@en .

sppc:rb-immutable a skos:Concept ;
    skos:inScheme sppc:rollback-policy ;
    skos:prefLabel "Immutable + replace"@en .

sppc:rb-linear a skos:Concept ;
    skos:definition "Linearly increasing delay between retry attempts (delay = initial * attempt_count)."@en ;
    skos:inScheme sppc:retry-backoff ;
    skos:prefLabel "linear"@en .

sppc:rb-manual a skos:Concept ;
    skos:inScheme sppc:rollback-policy ;
    skos:prefLabel "Manual"@en .

