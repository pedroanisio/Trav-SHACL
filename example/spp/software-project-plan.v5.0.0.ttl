        sppc:it-pulumi,
        sppc:it-puppet,
        sppc:it-terraform ;
    spp:axisPosition spp:axisPhase ;
    spp:groundedIn sppsrc:cncf-landscape ;
    spp:groundingStatus sppst:PARTIALLY_GROUNDED ;
    spp:tier sppt:T2 .

sppc:transport-kind a skos:ConceptScheme ;
    dcterms:title "Transport Kind"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Wire-level transport family for an operation binding. Backend-spec Transport.kind enum."@en ;
    skos:hasTopConcept sppc:tk-amqp,
        sppc:tk-cli,
        sppc:tk-graphql,
        sppc:tk-grpc,
        sppc:tk-http,
        sppc:tk-kafka,
        sppc:tk-library,
        sppc:tk-nats,
        sppc:tk-rpc-in-process,
        sppc:tk-sse,
        sppc:tk-stdio,
        sppc:tk-websocket ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:amqp-0-9-1,
        sppsrc:backend-spec-v1-1-0,
        sppsrc:kafka-protocol,
        sppsrc:nats-protocol,
        sppsrc:rfc6455,
        sppsrc:rfc9110 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

spp:ArchitecturalDecision a owl:Class ;
    rdfs:label "Architectural Decision"@en ;
    rdfs:comment "A first-class ADR per ISO/IEC/IEEE 42010:2022 §7.4."@en ;
    rdfs:subClassOf prov:Entity .

spp:AuthScheme a owl:Class ;
    rdfs:label "Auth Scheme"@en ;
    rdfs:comment "A declared authentication scheme accepted by an interface."@en ;
    spp:groundedIn sppsrc:oidc-core-1,
        sppsrc:rfc6749,
        sppsrc:webauthn-2 .

spp:BackendSpecProjection a owl:Class ;
    rdfs:label "Backend Spec Projection"@en ;
    rdfs:comment "A contract declaring how one SPP component projects into a backend_spec document."@en .

sppsrc:iso19505-2-2012 a spp:GroundingSource ;
    dcterms:identifier "ISO/IEC 19505-2:2012" ;
    dcterms:issued "2012-04"^^xsd:gYearMonth ;
    dcterms:source <https://www.iso.org/standard/52854.html> ;
    dcterms:title "ISO/IEC 19505-2:2012 — Unified Modeling Language (UML) Superstructure 2.4.1"@en ;
    rdfs:comment "ISO publication of UML; behavioural classifiers, state machines, classifiers, multiplicity."@en ;
    spp:sourceTier "T1" .

sppst:FRAMEWORK_INTERNAL a skos:Concept ;
    skos:definition """Introduced in v4.1.0 (P1 #9). Reserved for
        nodes that describe the framework itself (axes, meta-schemes,
        internal classification structures) rather than project-time
        decisions. Such nodes are inappropriate targets for the
        axisPosition / tier / groundedIn invariant — demanding that
        an axis declare its own axisPosition is circular. The
        ConceptSchemeMetadataShape's SPARQL target uses this verdict
        as the primary exemption signal, so future framework-internal
        classes can be exempted by annotation rather than by adding
        another `FILTER NOT EXISTS` clause."""@en ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "FRAMEWORK_INTERNAL"@en .

sppc:ci-cd-provider a skos:ConceptScheme ;
    dcterms:title "CI/CD Provider"@en ;
    rdfs:comment "Vendor catalog. CNCF landscape catalogs open-source providers; commercial providers are vendor-canonical only."@en ;
    skos:hasTopConcept sppc:cicd-argocd,
        sppc:cicd-aws-codepipeline,
        sppc:cicd-azure-pipelines,
        sppc:cicd-buildkite,
        sppc:cicd-circleci,
        sppc:cicd-drone,
        sppc:cicd-gcp-cloud-build,
        sppc:cicd-github-actions,
        sppc:cicd-gitlab-ci,
        sppc:cicd-jenkins,
        sppc:cicd-teamcity,
        sppc:cicd-tekton ;
    spp:axisPosition spp:axisPhase ;
    spp:groundedIn sppsrc:cncf-landscape,
        sppsrc:hilton-2016 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:tier sppt:T2 .

sppc:decision-consequence-kind a skos:ConceptScheme,
        spp:MetaScheme ;
    dcterms:title "Decision Consequence Kind"@en ;
    rdfs:comment "What is affected by the decision (the trade-offs). Aligns with ATAM (Kazman 2000) sensitivity points + ISO 25010 characteristics."@en ;
    skos:hasTopConcept sppc:dck-availability,
        sppc:dck-cost,
        sppc:dck-latency,
        sppc:dck-maintainability,
        sppc:dck-op-complexity,
        sppc:dck-performance,
        sppc:dck-privacy,
        sppc:dck-safety,
        sppc:dck-scalability,
        sppc:dck-security,
        sppc:dck-throughput,
        sppc:dck-vendor-lockin ;
    spp:groundedIn sppsrc:atam,
        sppsrc:iso25010-2023,
        sppsrc:kruchten-2004 .

sppc:module-role a skos:ConceptScheme ;
    dcterms:title "Module Role"@en ;
    rdfs:comment "Component roles from DDD layered architecture and hexagonal architecture. No single canonical enumeration; practitioner pattern."@en ;
    skos:hasTopConcept sppc:mr-adapter,
        sppc:mr-api,
        sppc:mr-application,
        sppc:mr-auth,
