    skos:inScheme sppc:command-result-kind ;
    skos:prefLabel "projection"@en .

sppc:result-void a skos:Concept ;
    skos:inScheme sppc:command-result-kind ;
    skos:prefLabel "void"@en .

sppc:rg-alloy a skos:Concept ;
    skos:definition "Alloy — first-order relational logic with bounded model checking. Typically design-time only."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "alloy"@en .

sppc:rg-cel a skos:Concept ;
    skos:definition "Google Common Expression Language (CEL) — non-Turing-complete expression evaluator for safe runtime evaluation."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "cel"@en .

sppc:rg-custom a skos:Concept ;
    skos:definition "A custom grammar defined explicitly by the spec; requires a BNF or operational description."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "custom"@en .

sppc:rg-json-logic a skos:Concept ;
    skos:definition "JsonLogic — JSON-serialised rule trees designed for cross-runtime evaluation."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "json_logic"@en .

sppc:rg-ocl-subset a skos:Concept ;
    skos:definition "A constrained subset of OMG's Object Constraint Language (OCL) suitable for code generation."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "ocl_subset"@en .

sppc:rg-rego a skos:Concept ;
    skos:definition "Rego — declarative policy language used by Open Policy Agent."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "rego"@en .

sppc:rg-tla-plus a skos:Concept ;
    skos:definition "TLA+ — Lamport's Temporal Logic of Actions. Typically design-time only."@en ;
    skos:inScheme sppc:rule-grammar ;
    skos:prefLabel "tla_plus"@en .

sppc:rl-any-region a skos:Concept ;
    skos:definition "Reads may be served from any region. Maximises latency benefits and read throughput; permits stale reads if replication is async."@en ;
    skos:inScheme sppc:read-locality ;
    skos:prefLabel "any_region"@en .

sppc:rl-follower-reads-allowed a skos:Concept ;
    skos:definition "Reads may be served by followers (replicas) of the home region, typically with a declared bounded staleness."@en ;
    skos:inScheme sppc:read-locality ;
    skos:prefLabel "follower_reads_allowed"@en .

sppc:rl-home-region-only a skos:Concept ;
    skos:definition "Reads must be served from the entity's home (write-owner) region. Strongest consistency; highest cross-region read latency."@en ;
    skos:inScheme sppc:read-locality ;
    skos:prefLabel "home_region_only"@en .

sppc:rm-async a skos:Concept ;
    skos:definition "Asynchronous replication — writes commit locally before replicating; followers lag the leader. Recovery point objective (RPO) > 0."@en ;
    skos:inScheme sppc:replication-mode ;
    skos:prefLabel "async"@en .

sppc:rm-none a skos:Concept ;
    skos:definition "No cross-region replication. Each region is independent."@en ;
    skos:inScheme sppc:replication-mode ;
    skos:prefLabel "none"@en .

sppc:rm-sync a skos:Concept ;
    skos:definition "Synchronous replication — writes do not commit until acknowledged by followers (or a quorum). RPO = 0; higher write latency."@en ;
    skos:inScheme sppc:replication-mode ;
    skos:prefLabel "sync"@en .

