@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spp: <https://software-project-plan.org/v5/ontology#> .
@prefix sppc: <https://software-project-plan.org/v5/concept/> .
@prefix sppsh: <https://software-project-plan.org/v5/shape#> .
@prefix sppsrc: <https://software-project-plan.org/v5/source#> .
@prefix sppst: <https://software-project-plan.org/v5/status#> .
@prefix sppt: <https://software-project-plan.org/v5/tier#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sppc:cat-msp a skos:Collection ;
    dcterms:source <https://microservices.io/patterns/> ;
    dcterms:title "Microservices Patterns catalog (Richardson 2018)"@en ;
    rdfs:comment """Lifted from canonical/seed/msp-taxonomy.json (retired)
        on 2026-05-16. Member set is recalled from secondary memory of
        Richardson 2018 and was NOT re-verified against the primary source
        in this lift. Ground-verification of each member is open work for
        a future v4.3.x cleanup."""@en ;
    skos:member sppc:cmp-async-request-reply,
        sppc:cmp-domain-specific-protocol,
        sppc:cmp-idempotent-consumer,
        sppc:cmp-messaging,
        sppc:cmp-rpi,
        sppc:dcp-api-composition,
        sppc:dcp-cqrs,
        sppc:dcp-database-per-service,
        sppc:dcp-domain-event,
        sppc:dcp-event-sourcing,
        sppc:dcp-polling-publisher,
        sppc:dcp-saga,
        sppc:dcp-saga-choreography,
        sppc:dcp-saga-orchestration,
        sppc:dcp-shared-database,
        sppc:dcp-transaction-log-tailing,
        sppc:dcp-transactional-outbox,
        sppc:dep-adapter,
        sppc:dep-ambassador,
        sppc:dep-instance-per-container,
        sppc:dep-instance-per-host,
        sppc:dep-instance-per-vm,
        sppc:dep-multiple-per-host,
        sppc:dep-platform,
        sppc:dep-serverless,
        sppc:dep-service-mesh,
        sppc:dep-sidecar,
        sppc:dp-by-business-capability,
        sppc:dp-by-subdomain,
        sppc:dp-self-contained-service,
        sppc:dp-service-per-team,
        sppc:dsv-client-side,
        sppc:dsv-self-registration,
        sppc:dsv-server-side,
        sppc:dsv-service-registry,
        sppc:dsv-third-party-registration,
        sppc:gwp-api-gateway,
        sppc:gwp-backend-for-frontend,
        sppc:mcp-externalized-configuration,
        sppc:mcp-microservice-chassis,
        sppc:mcp-service-template,
        sppc:obp-application-metrics,
        sppc:obp-audit-logging,
        sppc:obp-distributed-tracing,
        sppc:obp-exception-tracking,
        sppc:obp-health-check-api,
        sppc:obp-log-aggregation,
        sppc:obp-log-deployments-and-changes,
        sppc:rfp-anti-corruption-layer,
        sppc:rfp-strangler-fig,
        sppc:rsp-bulkhead,
        sppc:rsp-circuit-breaker,
        sppc:rsp-rate-limiting,
        sppc:rsp-retry,
        sppc:rsp-steady-state,
        sppc:rsp-timeout,
        sppc:scp-access-token,
        sppc:scp-identity-propagation,
        sppc:tsp-consumer-driven-contract,
        sppc:tsp-consumer-side-contract,
        sppc:tsp-service-component,
        sppc:uic-client-side-composition,
        sppc:uic-server-side-composition ;
    spp:groundedIn sppsrc:richardson-2018,
        sppsrc:richardson-site ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY .

sppc:extension-registry a skos:ConceptScheme,
        spp:MetaScheme ;
    dcterms:title "Extension registry"@en ;
    rdfs:comment """Registry of known third-party extension schemes. Each
        registered extension is a skos:Concept in this scheme whose
        skos:definition declares the extension's IRI prefix and base
        scheme. The registry is empty in v4.3.0; entries arrive as
        extensions are published. SHACL openness-aware shapes consult
        this scheme to determine which child schemes may extend a given
        `spp:extensible` parent."""@en ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL .

sppc:idempotency-policy-collection a skos:Collection ;
    rdfs:label "Idempotency Policy (collection over delivery-guarantee + idempotency-key-policy)"@en ;
    rdfs:comment "Convenience Collection grouping the post-split sub-schemes. Use this when iterating over all idempotency-related concepts in one pass."@en ;
    skos:member sppc:idem-all-commands,
        sppc:idem-at-least-once,
        sppc:idem-at-most-once,
        sppc:idem-compensable,
        sppc:idem-exactly-once,
        sppc:idem-explicit-per-command,
        sppc:idem-idempotent-by-key,
        sppc:idem-off .

spp:Categorical a owl:Class ;
    rdfs:label "Categorical vocabulary"@en ;
    rdfs:comment """A concept scheme that contributes a categorical
        decision vocabulary to the plan. Subclass of skos:ConceptScheme.
        Distinguished from spp:MetaScheme, which describes the framework
        itself rather than a plan-time decision."""@en ;
    rdfs:subClassOf skos:ConceptScheme .

spp:SourceTier a owl:Class ;
    rdfs:label "Source authority tier"@en ;
    rdfs:comment """T1 = peer-reviewed paper or ISO/IEEE/IETF/OMG
        standard. T2 = official documentation or vendor architecture
        framework. T3 = verified industry dataset. T4 = high-quality
        expert article or book by recognised authority. T5 = community
        knowledge."""@en .

spp:contributedBy a owl:ObjectProperty ;
    rdfs:label "contributed by"@en ;
    rdfs:comment """The contributing party for an extension. Lightweight
        provenance for the extension registry; not a substitute for
        PROV-O when full provenance modelling is required. Use prov:wasAttributedTo
        instead when the contribution needs to be linked to a PROV
        agent + activity."""@en .

spp:decisionOptionStatus a owl:ObjectProperty ;
    rdfs:domain spp:ArchitecturalDecision ;
    rdfs:range skos:Concept .

spp:groundingQuality a owl:DatatypeProperty ;
    rdfs:range xsd:string .

spp:sourceTier a owl:DatatypeProperty ;
    rdfs:range xsd:string .

sppsh:AggregateShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:aggregateName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:Entity ;
            sh:maxCount 1 ;
            sh:message "An aggregate must have exactly one root entity."@en ;
            sh:minCount 1 ;
            sh:path spp:aggregateRoot ],
        [ sh:class spp:Entity ;
            sh:path spp:aggregateMember ] ;
    sh:targetClass spp:Aggregate .

sppsh:ArchitecturalDecisionExtendedShape a sh:NodeShape ;
    sh:property [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Every ADR must have exactly one lifecycle status (proposed / accepted / rejected / deprecated / superseded / challenged)."@en ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:architectural-decision-status ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:decisionStatus ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:decision-target-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:decisionTargetKind ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:decision-consequence-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:decisionConsequenceKind ] ;
    sh:targetClass spp:ArchitecturalDecision .

sppsh:ArchitecturalDecisionShape a sh:NodeShape ;
    sh:property [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Every architectural decision must be classified by Kruchten kind (existence / property / executive / ban)."@en ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:decision-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:decisionKind ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:decision-force ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:decisionForce ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:reversibility-tier ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:reversibilityClass ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:technical-debt-type ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:technicalDebtType ] ;
    sh:targetClass spp:ArchitecturalDecision .

sppsh:AuthSchemeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:authSchemeName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "http_bearer" "api_key" "oauth2_code" "oauth2_client_credentials" "mtls" "openid_connect" "none" "token_env" "os_permissions" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:authSchemeKind ],
        [ sh:datatype xsd:string ;
            sh:path spp:authSchemeScope ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:path spp:authSchemeIssuerUrl ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:path spp:authSchemeJwksUri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:authSchemeAudience ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:authSchemeHeaderName ] ;
    sh:targetClass spp:AuthScheme .

sppsh:BackendSpecEmissionContractOwnedProjectionShape a sh:NodeShape ;
    rdfs:label "Backend spec emission contract owned projection"@en ;
    rdfs:comment "Emission contract: a Component's emission contract must reference one of that Component's backendSpecProjection nodes."@en ;
    sh:sparql [ sh:message "Component backendSpecEmissionContract {?contract} must reference one of the component's backendSpecProjection nodes."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?contract WHERE {
                $this spp:backendSpecEmissionContract ?contract .
                ?contract spp:emissionProjection ?projection .
                FILTER NOT EXISTS { $this spp:backendSpecProjection ?projection . }
            }
        """ ] ;
    sh:targetClass spp:Component .

sppsh:BackendSpecEmissionContractShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:class spp:BackendSpecProjection ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecEmissionContract must reference exactly one emissionProjection."@en ;
            sh:minCount 1 ;
            sh:path spp:emissionProjection ],
        [ sh:datatype xsd:string ;
            sh:hasValue "backend_spec" ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecEmissionContract must target backend_spec."@en ;
            sh:minCount 1 ;
            sh:path spp:emissionContractSchema ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecEmissionContract must declare emissionContractVersion."@en ;
            sh:minCount 1 ;
            sh:path spp:emissionContractVersion ],
        [ sh:datatype xsd:string ;
            sh:in ( "spp_ir_partial" "spp_ir_parity" ) ;
            sh:maxCount 1 ;
            sh:message "emissionParityStatus must be spp_ir_partial or spp_ir_parity."@en ;
            sh:minCount 1 ;
            sh:path spp:emissionParityStatus ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecEmissionContract must declare whether backend_spec validation is required."@en ;
            sh:minCount 1 ;
            sh:path spp:emissionRequiresBackendSpecValidation ],
        [ sh:datatype xsd:string ;
            sh:hasValue "L1-L21" ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecEmissionContract must keep backend_spec closure laws L1-L21 authoritative."@en ;
            sh:minCount 1 ;
            sh:path spp:emissionClosureLawSet ] ;
    sh:targetClass spp:BackendSpecEmissionContract .

sppsh:BackendSpecEmissionContractStrictUntilParityShape a sh:NodeShape ;
    rdfs:label "Backend spec emission strict until SPP IR parity"@en ;
    rdfs:comment "Emission contract: while SPP IR parity is partial, backend emission must still validate the generated backend_spec document and its closure laws."@en ;
    sh:sparql [ sh:message "BackendSpecEmissionContract must require backend_spec validation until SPP IR parity."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this WHERE {
                $this spp:emissionParityStatus ?status .
                FILTER (?status != "spp_ir_parity")
                FILTER NOT EXISTS {
                    $this spp:emissionRequiresBackendSpecValidation true .
                }
            }
        """ ] ;
    sh:targetClass spp:BackendSpecEmissionContract .

sppsh:BackendSpecEmissionContractVersionMatchesProjectionShape a sh:NodeShape ;
    rdfs:label "Backend spec emission version matches projection"@en ;
    rdfs:comment "Emission contract: the backend_spec version used for emission validation must match the projection target version."@en ;
    sh:sparql [ sh:message "BackendSpecEmissionContract version must match its projectionTargetVersion."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this WHERE {
                $this spp:emissionProjection ?projection ;
                      spp:emissionContractVersion ?version .
                ?projection spp:projectionTargetVersion ?projectionVersion .
                FILTER (STR(?version) != STR(?projectionVersion))
            }
        """ ] ;
    sh:targetClass spp:BackendSpecEmissionContract .

sppsh:BackendSpecProjectionOwnedByComponentShape a sh:NodeShape ;
    rdfs:label "Backend spec projection owner consistency"@en ;
    rdfs:comment "Projection contract: a Component's backendSpecProjection must name that same Component as projectionSourceComponent."@en ;
    sh:sparql [ sh:message "Component backendSpecProjection {?projection} must use the owning component as projectionSourceComponent."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?projection WHERE {
                $this spp:backendSpecProjection ?projection .
                ?projection spp:projectionSourceComponent ?source .
                FILTER (?source != $this)
            }
        """ ] ;
    sh:targetClass spp:Component .

sppsh:BackendSpecProjectionRequiredSectionsShape a sh:NodeShape ;
    rdfs:label "Backend spec required section coverage"@en ;
    rdfs:comment "Projection contract: every BackendSpecProjection must cover the seven required backend_spec v1.1.0 top-level sections."@en ;
    sh:sparql [ sh:message "BackendSpecProjection must declare projectionSection for required backend_spec section {?required}."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?required WHERE {
                { BIND("spec_meta" AS ?required) }
                UNION { BIND("data_model" AS ?required) }
                UNION { BIND("operations" AS ?required) }
                UNION { BIND("behavior" AS ?required) }
                UNION { BIND("interface" AS ?required) }
                UNION { BIND("cross_cutting" AS ?required) }
                UNION { BIND("non_functional" AS ?required) }
                FILTER NOT EXISTS {
                    $this spp:projectionSection ?section .
                    ?section spp:projectionSectionName ?required .
                }
            }
        """ ] ;
    sh:targetClass spp:BackendSpecProjection .

sppsh:BackendSpecProjectionSectionSourceShape a sh:NodeShape ;
    rdfs:label "Backend spec projection section source consistency"@en ;
    rdfs:comment "Projection contract: each projected section must be sourced from the projection's source component."@en ;
    sh:sparql [ sh:message "BackendSpecProjection section {?section} must use the same source component as the projection."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?section WHERE {
                $this spp:projectionSourceComponent ?source .
                $this spp:projectionSection ?section .
                ?section spp:projectionSectionSourceComponent ?sectionSource .
                FILTER (?sectionSource != ?source)
            }
        """ ] ;
    sh:targetClass spp:BackendSpecProjection .

sppsh:BackendSpecProjectionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:class spp:Component ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecProjection must declare exactly one projectionSourceComponent."@en ;
            sh:minCount 1 ;
            sh:path spp:projectionSourceComponent ],
        [ sh:datatype xsd:string ;
            sh:hasValue "backend_spec" ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecProjection must target backend_spec."@en ;
            sh:minCount 1 ;
            sh:path spp:projectionTargetSchema ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecProjection must declare projectionTargetVersion."@en ;
            sh:minCount 1 ;
            sh:path spp:projectionTargetVersion ],
        [ sh:class spp:BackendSpecSectionProjection ;
            sh:message "A BackendSpecProjection must declare all seven required backend_spec sections."@en ;
            sh:minCount 7 ;
            sh:path spp:projectionSection ] ;
    sh:targetClass spp:BackendSpecProjection .

sppsh:BackendSpecProjectionUniqueSectionShape a sh:NodeShape ;
    rdfs:label "Backend spec projection unique section names"@en ;
    rdfs:comment "Projection contract: each required backend_spec section appears at most once per projection."@en ;
    sh:sparql [ sh:message "BackendSpecProjection has duplicate projectionSectionName {?name}."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?name WHERE {
                $this spp:projectionSection ?a , ?b .
                FILTER (?a != ?b)
                ?a spp:projectionSectionName ?name .
                ?b spp:projectionSectionName ?name .
                FILTER (STR(?a) < STR(?b))
            }
        """ ] ;
    sh:targetClass spp:BackendSpecProjection .

sppsh:BackendSpecSectionProjectionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "spec_meta" "data_model" "operations" "behavior" "interface" "cross_cutting" "non_functional" ) ;
            sh:maxCount 1 ;
            sh:message "projectionSectionName must be one of the required backend_spec top-level sections."@en ;
            sh:minCount 1 ;
            sh:path spp:projectionSectionName ],
        [ sh:class spp:Component ;
            sh:maxCount 1 ;
            sh:message "A BackendSpecSectionProjection must declare exactly one projectionSectionSourceComponent."@en ;
            sh:minCount 1 ;
            sh:path spp:projectionSectionSourceComponent ] ;
    sh:targetClass spp:BackendSpecSectionProjection .

sppsh:CausalOrderingRuleShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:class spp:Event ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:causalBefore ],
        [ sh:class spp:Event ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:causalAfter ] ;
    sh:targetClass spp:CausalOrderingRule .

sppsh:CommandEmittedEventLocalShape a sh:NodeShape ;
    rdfs:label "Command emitted event local closure"@en ;
    rdfs:comment "Closure analogue: backend-spec L14. SPARQL-targeted."@en ;
    sh:sparql [ sh:message "Command {?cmd} emits event {?event}, but that event is not declared on the same component."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?cmd ?event WHERE {
                $this spp:command ?cmd .
                ?cmd spp:commandEmits ?event .
                FILTER NOT EXISTS { $this spp:event ?event }
            }
        """ ] ;
    sh:targetClass spp:Component .

sppsh:CommandShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:commandName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:Aggregate ;
            sh:maxCount 1 ;
            sh:message "A command must target exactly one aggregate."@en ;
            sh:minCount 1 ;
            sh:path spp:targetAggregate ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "commandEffectOp must be a concept in sppc:effect-op."@en ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:effect-op ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:commandEffectOp ],
        [ sh:class spp:FieldDecl ;
            sh:path spp:commandField ],
        [ sh:datatype xsd:string ;
            sh:path spp:commandPrecondition ],
        [ sh:datatype xsd:string ;
            sh:path spp:commandPostcondition ],
        [ sh:class spp:Event ;
            sh:path spp:commandEmits ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:command-result-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:commandResultKind ],
        [ sh:class spp:ErrorClass ;
            sh:message "A command must declare at least one ErrorClass (the empty error set is rejected — see SPP §11.10)."@en ;
            sh:minCount 1 ;
            sh:path spp:commandError ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:synthetic-error-key ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:commandSyntheticError ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path spp:operationAnonymous ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:operationRequiredScope ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:objectAuthRule ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:path spp:operationPurity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:idempotencyKeyField ],
        [ sh:datatype xsd:duration ;
            sh:maxCount 1 ;
            sh:path spp:idempotencyRetention ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:commandRule ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:effect-polarity ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:commandEffectPolarity ] ;
    sh:targetClass spp:Command .

sppsh:ComponentShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:title dcterms:description dcterms:conformsTo dcterms:identifier ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A component must have exactly one componentName."@en ;
            sh:minCount 1 ;
            sh:path spp:componentName ],
        [ sh:class spp:Dependency ;
            sh:path spp:declaredDependency ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:module-role ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:moduleRole ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:component-ownership ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:componentOwnership ],
        [ sh:maxCount 0 ;
            sh:message "currentVersion is a runtime fact; it does not belong in a plan."@en ;
            sh:path spp:currentVersion ;
            sh:severity sh:Violation ],
        [ sh:maxCount 0 ;
            sh:message "archivedAt is a runtime fact; it does not belong in a plan."@en ;
            sh:path spp:archivedAt ;
            sh:severity sh:Violation ],
        [ sh:class spp:Entity ;
            sh:path spp:entity ],
        [ sh:class spp:Aggregate ;
            sh:path spp:aggregate ],
        [ sh:class spp:Command ;
            sh:path spp:command ],
        [ sh:class spp:Query ;
            sh:path spp:query ],
        [ sh:class spp:Event ;
            sh:path spp:event ],
        [ sh:class spp:StateMachine ;
            sh:path spp:stateMachine ],
        [ sh:class spp:ErrorClass ;
            sh:path spp:errorClass ],
        [ sh:class spp:CausalOrderingRule ;
            sh:path spp:causalRule ],
        [ sh:class spp:TypeDecl ;
            sh:path spp:typeDecl ],
        [ sh:class spp:Saga ;
            sh:path spp:saga ],
        [ sh:class spp:SoftDeleteDecl ;
            sh:path spp:softDelete ],
        [ sh:class spp:PolymorphismDecl ;
            sh:path spp:polymorphism ],
        [ sh:class spp:Interface ;
            sh:path spp:interface ],
        [ sh:class spp:BackendSpecProjection ;
            sh:path spp:backendSpecProjection ],
        [ sh:class spp:BackendSpecEmissionContract ;
            sh:path spp:backendSpecEmissionContract ],
        [ sh:class spp:Guard ;
            sh:path spp:guard ],
        [ sh:class spp:PersistenceBinding ;
            sh:path spp:persistenceBinding ] ;
    sh:targetClass spp:Component .

sppsh:CompositeTypeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:typeName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "record" "sum" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:compositeKind ],
        [ sh:class spp:FieldDecl ;
            sh:path spp:compositeField ] ;
    sh:targetClass spp:CompositeType .

sppsh:ConceptSchemeMetadataShape a sh:NodeShape ;
    rdfs:comment """Applies to all project-decision concept schemes;
        framework-internal nodes (meta-schemes, axes, future internal
        classes) are exempted.

        v4.1.0: primary exemption signal is spp:groundingStatus
        sppst:FRAMEWORK_INTERNAL, declared by the node itself. The
        class-based exemptions (NOT EXISTS for spp:MetaScheme /
        spp:Axis) are retained as defence-in-depth so that a partially
        annotated graph still validates correctly. Future
        framework-internal classes should be annotated rather than
        added to the SPARQL filter."""@en ;
    sh:property [ sh:message "Every scheme should declare an axisPosition."@en ;
            sh:minCount 1 ;
            sh:path spp:axisPosition ;
            sh:severity sh:Warning ],
        [ sh:message "Every scheme should declare a reversibility tier."@en ;
            sh:minCount 1 ;
            sh:path spp:tier ;
            sh:severity sh:Warning ],
        [ sh:message "Every scheme should declare a grounding status."@en ;
            sh:minCount 1 ;
            sh:path spp:groundingStatus ;
            sh:severity sh:Warning ],
        [ sh:message "Schemes with grounding status PRACTITIONER_ONLY may have zero formal sources; FORMALLY/PARTIALLY_GROUNDED schemes should cite at least one."@en ;
            sh:path spp:groundedIn ;
            sh:severity sh:Info ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX spp:  <https://software-project-plan.org/v5/ontology#>
            PREFIX sppst: <https://software-project-plan.org/v5/status#>
            SELECT ?this WHERE {
                ?this rdf:type skos:ConceptScheme .
                # Primary exemption (v4.1.0): framework-internal nodes
                # declare their status explicitly. New framework-internal
                # classes (e.g. a future spp:Lens) need only carry
                # spp:groundingStatus sppst:FRAMEWORK_INTERNAL to be
                # exempted; no SPARQL change required.
                FILTER NOT EXISTS { ?this spp:groundingStatus sppst:FRAMEWORK_INTERNAL . }
                # Legacy exemptions (kept as defence-in-depth for any
                # framework-internal node that has not yet been
                # annotated with the FRAMEWORK_INTERNAL status):
                FILTER NOT EXISTS { ?this rdf:type spp:MetaScheme . }
                FILTER NOT EXISTS { ?this rdf:type spp:Axis . }
            }
        """ ] .

sppsh:DependencyShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:title dcterms:description dcterms:conformsTo dcterms:identifier ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A dependency must have exactly one dependencyName."@en ;
            sh:minCount 1 ;
            sh:path spp:dependencyName ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Every declared dependency should specify its kind."@en ;
            sh:node [ sh:property [ sh:hasValue sppc:dependency-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:dependencyKind ;
            sh:severity sh:Warning ],
        [ sh:maxCount 0 ;
            sh:message "resolvedVersion is computed by a resolver at build time, not declared in a plan."@en ;
            sh:path spp:resolvedVersion ;
            sh:severity sh:Violation ] ;
    sh:targetClass spp:Dependency .

sppsh:EntityShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:title dcterms:description dcterms:identifier ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "entityName must be PascalCase NameToken."@en ;
            sh:minCount 1 ;
            sh:path spp:entityName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:FieldDecl ;
            sh:message "An entity must declare at least one field."@en ;
            sh:minCount 1 ;
            sh:path spp:entityField ],
        [ sh:class spp:Invariant ;
            sh:path spp:entityInvariant ],
        [ sh:class spp:ReferenceDecl ;
            sh:path spp:entityReference ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:entityTenantField ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:path spp:entityLifecycle ] ;
    sh:targetClass spp:Entity .

sppsh:EnumerationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:typeName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:message "An enumeration must declare at least one enumValue."@en ;
            sh:minCount 1 ;
            sh:path spp:enumValue ] ;
    sh:targetClass spp:Enumeration .

sppsh:ErrorClassShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "errorClassName must be lower_snake_case."@en ;
            sh:minCount 1 ;
            sh:path spp:errorClassName ;
            sh:pattern "^[a-z][a-z0-9_]*$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 599 ;
            sh:message "errorClassStatus must be a 4xx or 5xx code per RFC 9110 / RFC 9457 §3.1."@en ;
            sh:minCount 1 ;
            sh:minInclusive 400 ;
            sh:path spp:errorClassStatus ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path spp:errorClassRetryable ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:errorClassDescription ] ;
    sh:targetClass spp:ErrorClass .

sppsh:ErrorEnvelopeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "rfc7807" "rfc9457" "graphql_errors" "custom" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:errorEnvelopeKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:errorEnvelopeMediaType ],
        [ sh:class spp:FieldDecl ;
            sh:path spp:errorEnvelopeField ] ;
    sh:targetClass spp:ErrorEnvelope .

sppsh:EventShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:eventName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:FieldDecl ;
            sh:message "An event must declare at least one payload field; the empty event is rejected (use a marker field if no data)."@en ;
            sh:minCount 1 ;
            sh:path spp:eventPayload ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:eventVersion ],
        [ sh:datatype xsd:string ;
            sh:in ( "backward" "forward" "full" "none" ) ;
            sh:maxCount 1 ;
            sh:path spp:eventCompatibility ] ;
    sh:targetClass spp:Event .

sppsh:FieldConstraintShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "regex" "min" "max" "min_length" "max_length" "enum_membership" "format" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:constraintKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:constraintValue ] ;
    sh:targetClass spp:FieldConstraint .

sppsh:FieldDeclShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "fieldName must be lower_snake_case."@en ;
            sh:minCount 1 ;
            sh:path spp:fieldName ;
            sh:pattern "^[a-z][a-z0-9_]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:fieldType ],
        [ sh:datatype xsd:string ;
            sh:in ( "one" "optional" "many" "many-unique" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:fieldCardinality ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:pii-classification ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:fieldClassification ],
        [ sh:class spp:FieldConstraint ;
            sh:path spp:fieldConstraint ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:fieldDescription ] ;
    sh:targetClass spp:FieldDecl .

sppsh:GuardShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label ) ;
    sh:property [ sh:class spp:Command ;
            sh:maxCount 1 ;
            sh:message "A guard must target exactly one Command via spp:guardNode."@en ;
            sh:minCount 1 ;
            sh:path spp:guardNode ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "A guard must declare exactly one guardKind from sppc:guard-kind."@en ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:guard-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:guardKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:guardParams ],
        [ sh:class spp:Command ;
            sh:maxCount 1 ;
            sh:path spp:guardRef ] ;
    sh:targetClass spp:Guard .

sppsh:IdentifierTypeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:typeName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:identifierFormat ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:identifierGeneration ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:identifierUniquenessScope ] ;
    sh:targetClass spp:IdentifierType .

sppsh:IndexDeclShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:indexFields ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path spp:indexUnique ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:indexKind ] ;
    sh:targetClass spp:IndexDecl .

sppsh:InterfaceErrorTaxonomyCoverageShape a sh:NodeShape ;
    rdfs:label "Interface error taxonomy coverage"@en ;
    rdfs:comment "Closure analogue: backend-spec L9. SPARQL-targeted."@en ;
    sh:sparql [ sh:message "Operation {?op} declares error {?err}, but no component interface lists it as interfaceErrorClass."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?op ?err WHERE {
                $this spp:interface ?iface .
                {
                    $this spp:command ?op .
                    ?op spp:commandError ?err .
                } UNION {
                    $this spp:query ?op .
                    ?op spp:queryError ?err .
                }
                FILTER NOT EXISTS {
                    $this spp:interface ?anyIface .
                    ?anyIface spp:interfaceErrorClass ?err .
                }
            }
        """ ] ;
    sh:targetClass spp:Component .

sppsh:InterfaceOperationCoverageShape a sh:NodeShape ;
    rdfs:label "Interface operation coverage"@en ;
    rdfs:comment "Closure analogue: backend-spec L8. SPARQL-targeted."@en ;
    sh:sparql [ sh:message "Component declares an interface but operation {?op} has no interface operation binding."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this ?op WHERE {
                $this spp:interface ?iface .
                { $this spp:command ?op } UNION { $this spp:query ?op }
                FILTER NOT EXISTS {
                    $this spp:interface ?boundIface .
                    ?boundIface spp:interfaceOperationBinding ?binding .
                    ?binding spp:operationBindingOperation ?op .
                }
            }
        """ ] ;
    sh:targetClass spp:Component .

sppsh:InterfaceShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:class spp:Transport ;
            sh:message "An interface must declare at least one transport."@en ;
            sh:minCount 1 ;
            sh:path spp:interfaceTransport ],
        [ sh:class spp:WireFormat ;
            sh:message "An interface must declare at least one wire format."@en ;
            sh:minCount 1 ;
            sh:path spp:interfaceWireFormat ],
        [ sh:class spp:OperationBinding ;
            sh:message "An interface must declare at least one operation binding."@en ;
            sh:minCount 1 ;
            sh:path spp:interfaceOperationBinding ],
        [ sh:class spp:OperationAuth ;
            sh:path spp:interfaceOperationAuth ],
        [ sh:class spp:ErrorEnvelope ;
            sh:maxCount 1 ;
            sh:message "An interface must declare exactly one error envelope."@en ;
            sh:minCount 1 ;
            sh:path spp:interfaceErrorEnvelope ],
        [ sh:class spp:ErrorClass ;
            sh:message "An interface must declare at least one error class."@en ;
            sh:minCount 1 ;
            sh:path spp:interfaceErrorClass ],
        [ sh:class spp:AuthScheme ;
            sh:message "An interface must declare at least one auth scheme."@en ;
            sh:minCount 1 ;
            sh:path spp:interfaceAuthScheme ] ;
    sh:targetClass spp:Interface .

sppsh:InvariantShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:invariantExpression ],
        [ sh:datatype xsd:string ;
            sh:in ( "violation" "warning" ) ;
            sh:maxCount 1 ;
            sh:path spp:invariantSeverity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:invariantGrammar ] ;
    sh:targetClass spp:Invariant .

sppsh:MoneyTypeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:typeName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:moneyCurrency ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:moneyMinorUnit ],
        [ sh:datatype xsd:string ;
            sh:in ( "half-even" "half-up" "truncate" ) ;
            sh:maxCount 1 ;
            sh:path spp:moneyRoundingMode ] ;
    sh:targetClass spp:MoneyType .

sppsh:OperationAuthShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "command" "query" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:operationAuthKind ],
        [ sh:maxCount 1 ;
            sh:message "Operation auth must reference exactly one declared Command or Query."@en ;
            sh:minCount 1 ;
            sh:or ( [ sh:class spp:Command ] [ sh:class spp:Query ] ) ;
            sh:path spp:operationAuthOperation ],
        [ sh:class spp:AuthScheme ;
            sh:minCount 1 ;
            sh:path spp:operationAuthScheme ],
        [ sh:datatype xsd:string ;
            sh:in ( "any" "all" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:operationAuthCombinator ] ;
    sh:targetClass spp:OperationAuth .

sppsh:OperationBindingShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "command" "query" "event" "subscription" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:operationBindingKind ],
        [ sh:maxCount 1 ;
            sh:message "An operation binding must reference exactly one declared Command, Query, or Event."@en ;
            sh:minCount 1 ;
            sh:or ( [ sh:class spp:Command ] [ sh:class spp:Query ] [ sh:class spp:Event ] ) ;
            sh:path spp:operationBindingOperation ],
        [ sh:class spp:Transport ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:operationBindingTransport ],
        [ sh:class spp:WireFormat ;
            sh:maxCount 1 ;
            sh:path spp:operationBindingWireFormat ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:httpMethod ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:httpPath ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:messagingTopic ] ;
    sh:targetClass spp:OperationBinding .

sppsh:PersistenceBindingShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label ) ;
    sh:property [ sh:class spp:Entity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:persistenceEntity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:persistenceStorageKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:persistencePhysicalName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:persistenceTenantField ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:persistenceVersionField ],
        [ sh:class spp:IndexDecl ;
            sh:path spp:persistenceIndex ] ;
    sh:targetClass spp:PersistenceBinding .

sppsh:PlannedEnvironmentShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:title dcterms:description dcterms:conformsTo dcterms:identifier ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A planned environment must have exactly one environmentName."@en ;
            sh:minCount 1 ;
            sh:path spp:environmentName ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Every planned environment must declare its kind."@en ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:planned-environment-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:plannedEnvironmentKind ],
        [ sh:maxCount 0 ;
            sh:message "isActive is a runtime fact; it does not belong in a plan."@en ;
            sh:path spp:isActive ;
            sh:severity sh:Violation ] ;
    sh:targetClass spp:PlannedEnvironment .

sppsh:PlannedLinkShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:title dcterms:description dcterms:conformsTo dcterms:identifier ) ;
    sh:property [ sh:class spp:Component ;
            sh:maxCount 1 ;
            sh:message "A planned link must declare exactly one source component."@en ;
            sh:minCount 1 ;
            sh:path spp:linkSource ],
        [ sh:class spp:Component ;
            sh:maxCount 1 ;
            sh:message "A planned link must declare exactly one target component."@en ;
            sh:minCount 1 ;
            sh:path spp:linkTarget ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:planned-link-relation ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:plannedLinkRelation ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:runtime-relation ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:runtimeRelation ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:data-relation-cardinality ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:dataRelationCardinality ] ;
    sh:targetClass spp:PlannedLink .

sppsh:PolymorphismDeclShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A polymorphism declaration must name exactly one base type."@en ;
            sh:minCount 1 ;
            sh:path spp:polymorphismBaseType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "polymorphismDiscriminator must be lower_snake_case."@en ;
            sh:minCount 1 ;
            sh:path spp:polymorphismDiscriminator ;
            sh:pattern "^[a-z][a-z0-9_]*$" ],
        [ sh:datatype xsd:string ;
            sh:message "A polymorphism declaration must declare at least one variant."@en ;
            sh:minCount 1 ;
            sh:path spp:polymorphismVariant ] ;
    sh:targetClass spp:PolymorphismDecl .

sppsh:PrimitiveTypeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:typeName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:primitiveBase ] ;
    sh:targetClass spp:PrimitiveType .

sppsh:PublicPlanRequiresPrivacyAndSbomShape owl:sameAs sppsh:PublicallyReadablePlanRequiresPrivacyAndSbomShape .

sppsh:QueryShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:queryName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:Entity ;
            sh:minCount 1 ;
            sh:path spp:queryTarget ],
        [ sh:class spp:FieldDecl ;
            sh:path spp:queryField ],
        [ sh:class spp:ErrorClass ;
            sh:path spp:queryError ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:synthetic-error-key ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:querySyntheticError ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:effect-polarity ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:queryEffectPolarity ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path spp:operationAnonymous ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:operationRequiredScope ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:objectAuthRule ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:path spp:operationPurity ] ;
    sh:targetClass spp:Query .

sppsh:ReferenceDeclShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:class spp:Entity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:referenceFromEntity ],
        [ sh:class spp:Entity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:referenceToEntity ],
        [ sh:datatype xsd:string ;
            sh:in ( "one-to-one" "one-to-many" "many-to-one" "many-to-many" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:referenceCardinality ],
        [ sh:datatype xsd:string ;
            sh:in ( "restrict" "cascade" "set_null" "set_default" "no_action" ) ;
            sh:maxCount 1 ;
            sh:path spp:referenceOnDelete ] ;
    sh:targetClass spp:ReferenceDecl .

sppsh:SagaLocalReferenceShape a sh:NodeShape ;
    rdfs:label "Saga local reference closure"@en ;
    rdfs:comment "Closure analogue: backend-spec L13. SPARQL-targeted."@en ;
    sh:sparql [ sh:message "Saga reference {?ref} is not declared on the same component as the saga."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
    PREFIX spp: <https://software-project-plan.org/v5/ontology#>
    SELECT $this ?ref WHERE {
        $this spp:saga ?saga .
        {
            ?saga spp:sagaTriggerEvent ?ref .
            FILTER NOT EXISTS { $this spp:event ?ref }
        } UNION {
            ?saga spp:sagaStep ?step .
            ?step spp:sagaStepCommand ?ref .
            FILTER NOT EXISTS { $this spp:command ?ref }
            FILTER NOT EXISTS {
                $this spp:declaredDependency/spp:dependencyName ?depName .
                ?depComponent spp:componentName ?depName .
                ?depComponent spp:command ?ref .
            }
        } UNION {
            ?saga spp:sagaStep ?step .
            ?step spp:sagaStepCompensate ?ref .
            FILTER NOT EXISTS { $this spp:command ?ref }
            FILTER NOT EXISTS {
                $this spp:declaredDependency/spp:dependencyName ?depName .
                ?depComponent spp:componentName ?depName .
                ?depComponent spp:command ?ref .
            }
        }
    }
""" ] ;
    sh:targetClass spp:Component .

sppsh:SagaShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "sagaName must be PascalCase NameToken."@en ;
            sh:minCount 1 ;
            sh:path spp:sagaName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:Event ;
            sh:maxCount 1 ;
            sh:message "A saga must declare exactly one trigger event."@en ;
            sh:minCount 1 ;
            sh:path spp:sagaTriggerEvent ],
        [ sh:class spp:SagaStep ;
            sh:message "A saga must declare at least one sagaStep."@en ;
            sh:minCount 1 ;
            sh:path spp:sagaStep ] ;
    sh:targetClass spp:Saga .

sppsh:SagaStepShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "sagaStepName must be PascalCase NameToken."@en ;
            sh:minCount 1 ;
            sh:path spp:sagaStepName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:class spp:Command ;
            sh:maxCount 1 ;
            sh:message "A saga step must declare exactly one sagaStepCommand."@en ;
            sh:minCount 1 ;
            sh:path spp:sagaStepCommand ],
        [ sh:class spp:Command ;
            sh:maxCount 1 ;
            sh:path spp:sagaStepCompensate ],
        [ sh:datatype xsd:duration ;
            sh:maxCount 1 ;
            sh:path spp:sagaStepTimeout ] ;
    sh:targetClass spp:SagaStep .

sppsh:SchemeOpennessMetadataShape a sh:NodeShape ;
    rdfs:comment """Applies to all project-decision concept schemes;
        framework-internal nodes are exempted using the same SPARQL pattern
        as ConceptSchemeMetadataShape. Severity Info because the absence of
        spp:schemeOpenness defaults to spp:closed."""@en ;
    sh:property [ sh:in ( spp:closed spp:extensible spp:open ) ;
            sh:maxCount 1 ;
            sh:message "When declared, spp:schemeOpenness must be one of spp:closed, spp:extensible, spp:open. Default when undeclared is spp:closed."@en ;
            sh:path spp:schemeOpenness ;
            sh:severity sh:Info ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select """
            PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            PREFIX spp:  <https://software-project-plan.org/v5/ontology#>
            PREFIX sppst: <https://software-project-plan.org/v5/status#>
            SELECT ?this WHERE {
                ?this rdf:type skos:ConceptScheme .
                FILTER NOT EXISTS { ?this spp:groundingStatus sppst:FRAMEWORK_INTERNAL . }
                FILTER NOT EXISTS { ?this rdf:type spp:MetaScheme . }
                FILTER NOT EXISTS { ?this rdf:type spp:Axis . }
            }
        """ ] .

sppsh:ServiceLevelObjectiveShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:sloMetric ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:sloTarget ],
        [ sh:datatype xsd:duration ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:sloWindow ] ;
    sh:targetClass spp:ServiceLevelObjective .

sppsh:SoftDeleteDeclShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:class spp:Entity ;
            sh:maxCount 1 ;
            sh:message "A soft-delete declaration must name exactly one entity."@en ;
            sh:minCount 1 ;
            sh:path spp:softDeleteEntity ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "tombstoneField must be lower_snake_case."@en ;
            sh:minCount 1 ;
            sh:path spp:tombstoneField ;
            sh:pattern "^[a-z][a-z0-9_]*$" ],
        [ sh:datatype xsd:duration ;
            sh:maxCount 1 ;
            sh:path spp:retentionDuration ] ;
    sh:targetClass spp:SoftDeleteDecl .

sppsh:SoftwareProjectPlanShape a sh:NodeShape ;
    rdfs:comment """Closed shape: any property of a plan that is not
        listed here will produce a SHACL Violation. This is how the
        ontology enforces the plan/runtime abstraction boundary —
        properties like spp:currentVersion, spp:archivedAt, etc., are
        deliberately absent from this shape's sh:property list and will
        be rejected by validators."""@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:title dcterms:description dcterms:created dcterms:modified dcterms:conformsTo dcterms:identifier dcterms:hasVersion dcterms:creator dcterms:license dcterms:issued ) ;
    sh:property [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:monitoring-platform ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:monitoringPlatform ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:observability-practice ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:observabilityPractice ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:test-methodology ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:testMethodology ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:test-category ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:testCategory ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:test-technique ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:testTechnique ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:security-testing-practice ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:securityTestingPractice ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Security model is Tier-1; declare it explicitly (Zero Trust, least-privilege, etc.)."@en ;
            sh:node [ sh:property [ sh:hasValue sppc:security-model ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:securityModel ;
            sh:severity sh:Warning ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:supply-chain-security-practice ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:supplyChainSecurityPractice ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:privacy-compliance-practice ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:privacyCompliancePractice ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:process-methodology ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:processMethodology ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:engineering-practice ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:engineeringPractice ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:compliance-level ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:complianceLevel ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:documentation-approach ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:documentationApproach ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "A plan must have exactly one planName."@en ;
            sh:minCount 1 ;
            sh:path spp:planName ;
            sh:severity sh:Violation ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:ai-ml-posture ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:aiMlPosture ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:finops-posture ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:finOpsPosture ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:data-streaming-pattern ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:dataStreamingPattern ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:messaging-platform ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:messagingPlatform ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:planVersion ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:quality-characteristic ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:qualityCharacteristic ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:operational-excellence-area ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:operationalExcellenceArea ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:maintenance-type ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:maintenanceType ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:visibility ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:visibility ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:stakeholder-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:stakeholderAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:opportunity-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:opportunityAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:requirements-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:requirementsAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:software-system-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:softwareSystemAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:team-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:teamAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:way-of-working-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:wayOfWorkingAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:work-alpha-state ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:workAlphaState ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Tenancy model is a Tier-0 decision; declare it explicitly."@en ;
            sh:node [ sh:property [ sh:hasValue sppc:tenancy-model ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:tenancyModel ;
            sh:severity sh:Warning ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:concurrency-model ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:concurrencyModel ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:authentication-mechanism ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:authenticationMechanism ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:idempotency-policy ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:idempotencyPolicy ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:caching-strategy ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:cachingStrategy ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Privacy posture is regulatory-bearing (GDPR, ISO 31700); declare it explicitly."@en ;
            sh:node [ sh:property [ sh:hasValue sppc:privacy-posture ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:privacyPosture ;
            sh:severity sh:Warning ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:accessibility-posture ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:accessibilityPosture ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:sustainability-posture ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:sustainabilityPosture ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:sbom-policy ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:sbomPolicy ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:architecture-pattern ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:architecturePattern ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:data-storage-paradigm ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:dataStorageParadigm ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:consistency-model ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:consistencyModel ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:api-specification ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:apiSpecification ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:versioning-scheme ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:versioningScheme ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:deployment-strategy ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:deploymentStrategy ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:rollback-policy ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:rollbackPolicy ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:branching-strategy ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:branchingStrategy ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:system-of-systems-type ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:sosType ],
        [ sh:class spp:Component ;
            sh:message "A plan must declare at least one component."@en ;
            sh:minCount 1 ;
            sh:path spp:component ],
        [ sh:class spp:ArchitecturalDecision ;
            sh:path spp:decision ],
        [ sh:class spp:PlannedEnvironment ;
            sh:path spp:plannedEnvironment ],
        [ sh:class spp:PlannedLink ;
            sh:path spp:plannedLink ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "Project kind is Tier-0; declare it explicitly."@en ;
            sh:node [ sh:property [ sh:hasValue sppc:project-kind ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:projectKind ;
            sh:severity sh:Warning ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:runtime-platform ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:runtimePlatform ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:cloud-topology ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:cloudTopology ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:ci-cd-provider ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:ciCdProvider ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:build-tool ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:buildTool ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:container-tool ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:containerTool ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:infrastructure-tool ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:infrastructureTool ],
        [ sh:class skos:Concept ;
            sh:node [ sh:property [ sh:hasValue sppc:platform-engineering-pattern ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:platformEngineeringPattern ],
        [ sh:datatype xsd:string ;
            sh:in ( "permissive" "strict" ) ;
            sh:maxCount 1 ;
            sh:path spp:emissionMode ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:node [ sh:property [ sh:hasValue sppc:behavior-grammar ;
                            sh:path skos:inScheme ] ] ;
            sh:path spp:planBehaviorGrammar ],
        [ sh:class spp:ServiceLevelObjective ;
            sh:path spp:serviceLevelObjective ] ;
    sh:targetClass spp:SoftwareProjectPlan .

sppsh:StateMachineShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:stateMachineName ],
        [ sh:class spp:Entity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:stateMachineOf ],
        [ sh:class spp:FieldDecl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:stateField ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:initialState ],
        [ sh:class spp:Transition ;
            sh:minCount 1 ;
            sh:path spp:transition ] ;
    sh:targetClass spp:StateMachine .

sppsh:StateSubsetShape a sh:NodeShape ;
    rdfs:label "State subset"@en ;
    rdfs:comment "Closure analogue: backend-spec L6. SPARQL-targeted."@en ;
    sh:sparql [ sh:message "Transition references state {?s} which is not a concept of the state field's scheme."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp:  <https://software-project-plan.org/v5/ontology#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT $this ?s WHERE {
                $this spp:transition ?t .
                { ?t spp:transitionFrom ?s } UNION { ?t spp:transitionTo ?s }
                $this spp:stateField ?f .
                ?f spp:fieldType ?ft .
                FILTER NOT EXISTS {
                    ?s skos:inScheme ?scheme .
                    FILTER ( STR(?scheme) = ?ft )
                }
            }
        """ ] ;
    sh:targetClass spp:StateMachine .

sppsh:StrictCommandAuthShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: effectful Command {$this} declares neither operationRequiredScope nor operationAnonymous." ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this WHERE {
                ?plan spp:emissionMode "strict" .
                ?plan spp:component/spp:command $this .
                OPTIONAL { $this spp:operationPurity ?p }
                FILTER ( !BOUND(?p) || ?p != sppc:op-pure )
                FILTER NOT EXISTS { $this spp:operationRequiredScope ?s }
                FILTER NOT EXISTS { $this spp:operationAnonymous true }
            }
        """ ] ;
    sh:targetClass spp:Command .

sppsh:StrictCommandBehaviorShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: Command {$this} has no commandRule and no precondition+postcondition pair." ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this WHERE {
                ?plan spp:emissionMode "strict" .
                ?plan spp:component/spp:command $this .
                OPTIONAL { $this spp:operationPurity ?p }
                FILTER ( !BOUND(?p) || ?p != sppc:op-pure )
                FILTER NOT EXISTS { $this spp:commandRule ?r }
                FILTER NOT EXISTS {
                    $this spp:commandPrecondition ?pre .
                    $this spp:commandPostcondition ?post .
                }
            }
        """ ] ;
    sh:targetClass spp:Command .

sppsh:StrictMutatingIdempotencyShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: mutating Command {$this} requires spp:idempotencyKeyField." ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this WHERE {
                ?plan spp:emissionMode "strict" .
                ?plan spp:component/spp:command $this .
                $this spp:commandEffectOp ?eff .
                FILTER( ?eff != sppc:effect-side-effect )
                OPTIONAL { $this spp:operationPurity ?p }
                FILTER ( !BOUND(?p) || ?p != sppc:op-pure )
                FILTER NOT EXISTS { $this spp:idempotencyKeyField ?k }
            }
        """ ] ;
    sh:targetClass spp:Command .

sppsh:StrictPersistentEntityNeedsBindingShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: Component {$this} has persistent Entity {?e} but no PersistenceBinding for it." ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this ?e WHERE {
                ?plan spp:emissionMode "strict" ;
                      spp:component $this .
                $this spp:entity ?e .
                # Only persistent entities (default) need bindings;
                # ephemeral and session entities are exempt.
                OPTIONAL { ?e spp:entityLifecycle ?lc }
                FILTER ( !BOUND(?lc) || ?lc = sppc:el-persistent )
                FILTER NOT EXISTS {
                    $this spp:persistenceBinding ?pb .
                    ?pb spp:persistenceEntity ?e .
                }
            }
        """ ] ;
    sh:targetClass spp:Component .

sppsh:StrictRequiresBehaviorGrammarShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: plan must declare spp:planBehaviorGrammar so command rules and conditions are interpretable." ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            SELECT $this WHERE {
                $this spp:emissionMode "strict" .
                FILTER NOT EXISTS { $this spp:planBehaviorGrammar ?g }
            }
        """ ] ;
    sh:targetClass spp:SoftwareProjectPlan .

sppsh:StrictRequiresSLOValuesShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: plan declares obs-slo-sli-sla but has no ServiceLevelObjective with concrete target." ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this WHERE {
                $this spp:emissionMode "strict" .
                $this spp:observabilityPractice sppc:obs-slo-sli-sla .
                FILTER NOT EXISTS { $this spp:serviceLevelObjective ?slo }
            }
        """ ] ;
    sh:targetClass spp:SoftwareProjectPlan .

sppsh:StrictSideEffectCommandNeedsPolarityShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: side-effect Command {$this} must declare commandEffectPolarity explicitly (no default; declare observing / mutating_reversible / mutating_terminal as appropriate)."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this WHERE {
                ?plan spp:emissionMode "strict" .
                ?plan spp:component/spp:command $this .
                $this spp:commandEffectOp sppc:effect-side-effect .
                OPTIONAL { $this spp:operationPurity ?p }
                FILTER ( !BOUND(?p) || ?p != sppc:op-pure )
                FILTER NOT EXISTS { $this spp:commandEffectPolarity ?pol }
            }
        """ ] ;
    sh:targetClass spp:Command .

sppsh:StrictTerminalCommandNeedsGuardShape a sh:NodeShape ;
    sh:sparql [ sh:message "Strict-mode: Command {$this} has mutating-terminal polarity but no Guard targets it. Declare a Guard with guardNode = {$this} (defense in depth: multiple guards permitted)."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp: <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this WHERE {
                ?plan spp:emissionMode "strict" .
                ?plan spp:component ?c .
                ?c spp:command $this .
                $this spp:commandEffectPolarity sppc:pol-mutating-terminal .
                FILTER NOT EXISTS {
                    ?c spp:guard ?g .
                    ?g spp:guardNode $this .
                }
            }
        """ ] ;
    sh:targetClass spp:Command .

sppsh:TemporalTypeShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:comment rdfs:label ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:typeName ],
        [ sh:datatype xsd:string ;
            sh:in ( "instant" "wallclock" "date" "localtime" "duration" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:temporalKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:temporalZone ] ;
    sh:targetClass spp:TemporalType .

sppsh:TenancyConsistencyShape a sh:NodeShape ;
    rdfs:label "Tenancy consistency"@en ;
    rdfs:comment """Mirror of backend-spec framework closure law L12: when
        tenancyModel is anything other than single-tenant, every tenant-
        scoped Entity must declare entityTenantField. Implemented as a
        SHACL SPARQL constraint because it crosses the plan, the
        component, and the entity."""@en ;
    sh:sparql [ sh:message "Plan declares multi-tenant tenancyModel but Entity {?e} has no entityTenantField."@en ;
            sh:prefixes <https://software-project-plan.org/v5> ;
            sh:select """
            PREFIX spp:  <https://software-project-plan.org/v5/ontology#>
            PREFIX sppc: <https://software-project-plan.org/v5/concept/>
            SELECT $this ?e WHERE {
                $this spp:tenancyModel ?tm .
                FILTER ( ?tm != sppc:tenancy-single )
                $this spp:component ?c .
                ?c spp:entity ?e .
                FILTER NOT EXISTS { ?e spp:entityTenantField ?tf }
            }
        """ ] ;
    sh:targetClass spp:SoftwareProjectPlan .

sppsh:TransitionShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
    sh:property [ sh:class skos:Concept ;
            sh:message "A transition must declare at least one from-state."@en ;
            sh:minCount 1 ;
            sh:path spp:transitionFrom ],
        [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:message "A transition must have exactly one to-state."@en ;
            sh:minCount 1 ;
            sh:path spp:transitionTo ],
        [ sh:maxCount 1 ;
            sh:message "A transition trigger must be a Command or an Event."@en ;
            sh:minCount 1 ;
            sh:or ( [ sh:class spp:Command ] [ sh:class spp:Event ] ) ;
            sh:path spp:transitionTrigger ] ;
    sh:targetClass spp:Transition .

sppsh:TransportShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:transportName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "http" "grpc" "graphql" "amqp" "kafka" "nats" "websocket" "sse" "cli" "stdio" "library" "rpc_in_process" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:transportKind ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:path spp:transportBaseUrl ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:transportVersion ],
        [ sh:class spp:WireFormat ;
            sh:maxCount 1 ;
            sh:path spp:transportDefaultWireFormat ] ;
    sh:targetClass spp:Transport .

sppsh:WireFormatShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment dcterms:description ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:wireFormatName ;
            sh:pattern "^[A-Z][A-Za-z0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "json" "xml" "avro" "protobuf" "msgpack" "cbor" "yaml" "text" "binary_opaque" "internal" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path spp:wireFormatKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path spp:wireFormatEnvelope ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:path spp:wireFormatSchemaLink ] ;
    sh:targetClass spp:WireFormat .

sppsrc:azure-app-arch a spp:GroundingSource ;
    dcterms:source <https://learn.microsoft.com/en-us/azure/architecture/guide/> ;
    dcterms:title "Microsoft — Azure Application Architecture Fundamentals"@en ;
    spp:sourceTier "T2" .

sppsrc:azure-patterns a spp:GroundingSource ;
    dcterms:source <https://learn.microsoft.com/azure/architecture/patterns/> ;
    dcterms:title "Microsoft — Cloud Design Patterns"@en ;
    rdfs:comment "Microsoft's official cloud-architecture pattern catalog. Catalogs many MSP-cohort patterns under alternative names (e.g. \"Saga distributed transactions pattern\", \"Circuit Breaker pattern\")."@en ;
    spp:sourceTier "T2" .

sppsrc:capilla-2016 a spp:GroundingSource ;
    dcterms:identifier "10.1016/j.jss.2015.08.054" ;
    dcterms:title "Capilla et al. (2016). 10 years of software architecture knowledge management"@en ;
    spp:sourceTier "T1" .

sppsrc:incose-handbook-v5 a spp:GroundingSource ;
    dcterms:source <https://www.incose.org/products-and-publications/se-handbook> ;
    dcterms:title "INCOSE Systems Engineering Handbook v5 (2023)"@en ;
    spp:sourceTier "T2" .

sppsrc:kalliamvakou-2016 a spp:GroundingSource ;
    dcterms:identifier "10.1007/s10664-015-9393-5" ;
    dcterms:title "Kalliamvakou et al. (2016). In-depth study of the promises and perils of mining GitHub"@en ;
    spp:sourceTier "T1" .

