sppc:effect-polarity a skos:ConceptScheme ;
    dcterms:title "Effect polarity"@en ;
    rdfs:comment """Orthogonal classification of operation effects, independent of
        the resource touched. observing = read-only; mutating_reversible = state
        change rollbackable via compensation; mutating_terminal = state change
        absorbed by external systems beyond rollback (paid LLM call, sent email,
        charged card, persisted log)."""@en ;
    skos:hasTopConcept sppc:pol-mutating-reversible,
        sppc:pol-mutating-terminal,
        sppc:pol-observing ;
    spp:axisPosition spp:axisConcern ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:tier sppt:T1 .

