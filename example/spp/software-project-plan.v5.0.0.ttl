sppc:wow-in-use a skos:Concept ;
    skos:inScheme sppc:way-of-working-alpha-state ;
    skos:prefLabel "In Use"@en .

sppc:wow-principles-established a skos:Concept ;
    skos:inScheme sppc:way-of-working-alpha-state ;
    skos:prefLabel "Principles Established"@en .

sppc:wow-retired a skos:Concept ;
    skos:inScheme sppc:way-of-working-alpha-state ;
