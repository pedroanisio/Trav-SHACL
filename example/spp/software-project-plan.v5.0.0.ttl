sppc:guard-kind a skos:ConceptScheme ;
    dcterms:title "Guard kind"@en ;
    rdfs:comment """Pre-conditions for invocation of a Command whose effect
        polarity is mutating_terminal. Guards do not roll state back — terminal
        effects are unrollable by definition. Guards reduce the probability that
        the terminal effect is invoked unintentionally."""@en ;
    skos:hasTopConcept sppc:gk-budget-gate,
        sppc:gk-dry-run,
        sppc:gk-human-approval,
        sppc:gk-idempotency-key,
        sppc:gk-rate-limit ;
    spp:axisPosition spp:axisConcern ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:tier sppt:T1 .

sppc:maintenance-type a skos:ConceptScheme ;
    dcterms:title "Software Maintenance Type"@en ;
    rdfs:comment "Four-category core per ISO/IEC/IEEE 14764:2022. Emergency is a recognised urgency-variant of corrective per Lientz & Swanson tradition, NOT a peer category in the standard."@en ;
    skos:hasTopConcept sppc:maint-adaptive,
        sppc:maint-corrective,
        sppc:maint-emergency,
        sppc:maint-perfective,
        sppc:maint-preventive ;
    spp:axisPosition spp:axisPhase ;
    spp:groundedIn sppsrc:iso14764-2022 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T2 .

sppc:resilience-pattern a skos:ConceptScheme ;
