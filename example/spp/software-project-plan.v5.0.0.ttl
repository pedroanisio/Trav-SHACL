spp:Guard a owl:Class ;
    rdfs:label "Guard"@en ;
    rdfs:comment """A pre-condition gating invocation of a Command whose effects
        include at least one mutating_terminal effect (per commandEffectPolarity
        OR the default derivation when polarity is undeclared). Multiple guards
        may target the same Command (defense in depth)."""@en .

spp:OperationAuth a owl:Class ;
    rdfs:label "Operation Auth"@en ;
    rdfs:comment "An authorization binding from a declared command or query to one or more auth schemes."@en ;
    spp:groundedIn sppsrc:oidc-core-1,
        sppsrc:rfc6749,
        sppsrc:webauthn-2 .

spp:ReferenceDecl a owl:Class ;
    rdfs:label "Reference Declaration"@en ;
    rdfs:comment "A foreign-key-like declared link from one entity to another, with cardinality and optional cascade policy."@en ;
    spp:groundedIn sppsrc:iso19505-2-2012 .

spp:SagaStep a owl:Class ;
    rdfs:label "Saga Step"@en ;
    rdfs:comment "One step in a Saga workflow: command plus optional compensating command and timeout."@en ;
    spp:groundedIn sppsrc:garcia-molina-salem-1987,
        sppsrc:vernon-2013 .

