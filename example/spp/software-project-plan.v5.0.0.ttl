sppc:monitoring-platform a skos:ConceptScheme ;
    dcterms:title "Monitoring Platform"@en ;
    rdfs:comment "Vendor catalog. OpenTelemetry is the T1 standard for the wire protocol; tools vary."@en ;
    skos:hasTopConcept sppc:mon-azure-monitor,
        sppc:mon-cloudwatch,
        sppc:mon-datadog,
        sppc:mon-dynatrace,
        sppc:mon-elastic,
        sppc:mon-grafana,
        sppc:mon-honeycomb,
        sppc:mon-new-relic,
        sppc:mon-prometheus,
