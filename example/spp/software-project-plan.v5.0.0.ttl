    skos:definition "Industry consensus only; no formal standard."@en ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "PRACTITIONER_ONLY"@en .

<https://software-project-plan.org/v5> a owl:Ontology ;
    dcterms:conformsTo <https://www.w3.org/TR/owl2-overview/>,
        <https://www.w3.org/TR/shacl/> ;
    dcterms:creator "Software-Project-Plan working group"@en ;
    dcterms:description """A SHACL/TTL ontology describing the categorical
        decisions that constitute a software project plan, grounded in
        ISO 25010:2023, ISO/IEC/IEEE 12207:2017, ISO/IEC/IEEE 14764:2022,
        ISO/IEC/IEEE 15288:2015, ISO/IEC/IEEE 42010:2022, AWS
        Well-Architected, OMG SEMAT Essence kernel, Kruchten's ontology
        of architectural design decisions (2004), van Heesch et al.'s
        forces viewpoint (2012), and Alves et al.'s technical-debt
        taxonomy (2016). Each decision category is positioned in a
        four-axis space (Concern × Phase × Scope × Externality) and
        tagged with a reversibility tier (T0 Foundational → T3
        Tactical)."""@en ;
    dcterms:issued "2026-05-15"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Software Project Plan Ontology"@en ;
    vann:preferredNamespacePrefix "spp" ;
    vann:preferredNamespaceUri "https://software-project-plan.org/v5/ontology#" ;
    rdfs:comment """Disclaimer: Nothing in this ontology should be
        taken for granted. Any statement or premise not backed by a
        verifiable reference may be invalid, erroneous, or a
        hallucination. Tier and axis assignments are a structured
        synthesis, not consensus standards.

        VALIDATION CONTRACT (added in v4.1.0):
        Consumers MUST run SHACL validation with RDFS expansion
        DISABLED. The SHACL shapes in §11 are self-sufficient: each
        carries an explicit sh:targetClass and the closed shapes carry
        sh:ignoredProperties for legitimate Dublin Core metadata.

        Running pyshacl (or any SHACL engine) with inference='rdfs' on
        this graph plus an instance graph will produce spurious
        violations because:
          (a) rdfs:domain spp:SoftwareProjectPlan on planName /
              planVersion / spp:component / spp:decision causes any
              sub-entity that mistakenly carries one of those
              properties to be inferred as a SoftwareProjectPlan and
              cascade-fail the closed-shape constraint with dozens of
              missing-property violations;
          (b) rdfs:domain spp:Categorical on spp:groundedIn (now
              removed in v4.1.0) used to similarly promote framework
              internal nodes (axes, meta-schemes) into ConceptSchemes.
        The OWL-side domain declarations are kept for documentation
        and reasoner audits ("where is this property legal?"), not
        as runtime constraints. The SHACL closed shapes are the
        runtime constraint surface."""@en ;
    owl:versionIRI <https://software-project-plan.org/v5.0.0> ;
    owl:versionInfo "5.0.0" .

spp:FieldDecl a owl:Class ;
    rdfs:label "Field Declaration"@en ;
    rdfs:comment "A typed, cardinality-constrained field on an entity, command payload, query payload, or event."@en ;
    spp:groundedIn sppsrc:iso19505-2-2012 .

sppsrc:backend-spec-v1-1-0 a spp:GroundingSource ;
    dcterms:source <file:///software-project-plan/static/schemas/backend_spec.schema.v1.1.0.json> ;
    dcterms:title "Adequate Backend Specification, framework v1.1.0 (JSON Schema)"@en ;
    rdfs:comment "Six-axis (D/O/B/I/X/N) JSON Schema for backend specifications with closure laws L1–L21. Defines the canonical vocabulary for command effect ops, synthetic error keys, command result kinds, error envelopes, transports, wire formats, rule grammars, and other generator-emission categories. Internal framework artifact; T2 by convention (vendor/internal framework tier)."@en ;
    spp:sourceTier "T2" .

spp:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "A domain entity DECLARED in the component plan. Excludes runtime state of instances."@en ;
    rdfs:subClassOf prov:Entity ;
    spp:groundedIn sppsrc:evans-2003,
        sppsrc:iso19505-2-2012,
        sppsrc:vernon-2013 .

sppst:PARTIALLY_GROUNDED a skos:Concept ;
    skos:definition "Tier-2 or Tier-4 sources touch the concept but no Tier-1 standard endorses this exact partition."@en ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "PARTIALLY_GROUNDED"@en .

spp:axisPhase a spp:Axis ;
    rdfs:label "Phase axis"@en ;
    rdfs:comment "When in the lifecycle the decision binds."@en ;
    spp:groundedIn sppsrc:iso12207-2017,
        sppsrc:iso15288-2015 ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL .

spp:Command a owl:Class ;
    rdfs:label "Command"@en ;
    rdfs:comment "A mutating operation declared in the plan, addressed to a target aggregate."@en ;
    spp:groundedIn sppsrc:helland-2012,
        sppsrc:hoare-1969,
        sppsrc:liskov-wing-1994,
        sppsrc:vernon-2013 .

sppt:T2 a skos:Concept ;
    skos:definition "Expensive internal refactor; customers unaffected."@en ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T2 — Architectural"@en .

spp:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:comment "A constituent module of a project as DECLARED in the plan."@en .

sppst:FORMALLY_GROUNDED a skos:Concept ;
    skos:definition "At least one Tier-1 or Tier-2 source directly grounds this category's existence."@en ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "FORMALLY_GROUNDED"@en .

sppt:T1 a skos:Concept ;
    skos:definition "Reversible only via a coordinated migration affecting external contracts or persisted data."@en ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T1 — Structural"@en .

spp:axisConcern a spp:Axis ;
    rdfs:label "Concern axis"@en ;
    rdfs:comment "What aspect of the system the decision affects."@en ;
    spp:groundedIn sppsrc:aws-waf,
        sppsrc:iso25010-2023 ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL .

spp:SoftwareProjectPlan a owl:Class ;
    rdfs:label "Software Project Plan"@en ;
    rdfs:comment "A plan-time view of a software project. Excludes runtime facts."@en .

spp:GroundingSource a owl:Class ;
    rdfs:label "Grounding source"@en ;
    rdfs:subClassOf prov:Entity .

