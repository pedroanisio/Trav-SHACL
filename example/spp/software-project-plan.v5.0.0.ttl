    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T0 .

sppc:reversibility-tier a skos:ConceptScheme,
        spp:MetaScheme ;
    dcterms:title "Reversibility Tier"@en ;
    rdfs:comment """A four-level refinement of Bezos's binary
        one-way/two-way door distinction. Each tier names the typical
        cost of reversing a decision."""@en ;
