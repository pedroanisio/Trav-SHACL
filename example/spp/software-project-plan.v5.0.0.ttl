sppc:wcp-last-write-wins a skos:Concept ;
    skos:definition "Concurrent writes are accepted in arrival order; the last write overwrites prior values silently. No conflict detection."@en ;
    skos:inScheme sppc:write-conflict-policy ;
    skos:prefLabel "last_write_wins"@en .

sppc:wcp-optimistic-versioning a skos:Concept ;
    skos:definition "Writes carry a version (or ETag) read with the original row; the write fails if the current version no longer matches. Surfaces as stale_version per backend-spec L19."@en ;
    skos:inScheme sppc:write-conflict-policy ;
    skos:prefLabel "optimistic_versioning"@en .

sppc:wcp-pessimistic-lock a skos:Concept ;
    skos:definition "Reads acquire a lock on the aggregate; concurrent writers block until the holder commits or releases."@en ;
    skos:inScheme sppc:write-conflict-policy ;
    skos:prefLabel "pessimistic_lock"@en .

sppc:wf-avro a skos:Concept ;
    skos:definition "Apache Avro binary format with explicit schema. Schema-required."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "avro"@en .

sppc:wf-binary-opaque a skos:Concept ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "Opaque binary blob"@en .

sppc:wf-cbor a skos:Concept ;
    skos:definition "Concise Binary Object Representation per RFC 8949. JSON-shaped data model."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "cbor"@en .

sppc:wf-internal a skos:Concept ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "Internal in-process objects (no serialisation)"@en .

sppc:wf-json a skos:Concept ;
    skos:definition "JSON per RFC 8259. Text-based, schema-optional."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "json"@en .

sppc:wf-msgpack a skos:Concept ;
    skos:definition "MessagePack binary format. JSON-shaped data model, schema-optional."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "msgpack"@en .

sppc:wf-protobuf a skos:Concept ;
    skos:definition "Google Protocol Buffers binary format with explicit .proto schema. Schema-required."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "protobuf"@en .

sppc:wf-text a skos:Concept ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "Plain text (CLI output, logs)"@en .

sppc:wf-xml a skos:Concept ;
    skos:definition "XML 1.0 per W3C. Text-based, schema-supported via XSD."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "xml"@en .

sppc:wf-yaml a skos:Concept ;
    skos:definition "YAML 1.2 text format. JSON-superset data model, indentation-sensitive."@en ;
    skos:inScheme sppc:wire-format ;
    skos:prefLabel "yaml"@en .

sppc:work-closed a skos:Concept ;
    skos:inScheme sppc:work-alpha-state ;
