    dcterms:identifier "RFC 2104" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc2104> ;
    dcterms:title "IETF RFC 2104 — HMAC: Keyed-Hashing for Message Authentication"@en ;
    rdfs:comment "Authoritative HMAC construction. Ground for hmac_sha256 and hmac_sha512 in sppc:webhook-signature-scheme."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc4122 a spp:GroundingSource ;
    dcterms:identifier "RFC 4122" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc4122> ;
    dcterms:title "IETF RFC 4122 — A Universally Unique IDentifier (UUID) URN Namespace"@en ;
    rdfs:comment "Authoritative UUIDv4 specification. Ground for uuid_v4 in sppc:id-generation-strategy."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc6455 a spp:GroundingSource ;
    dcterms:identifier "RFC 6455" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc6455> ;
    dcterms:title "IETF RFC 6455 — The WebSocket Protocol"@en ;
    rdfs:comment "Authoritative WebSocket protocol specification. Ground for websocket in sppc:transport-kind."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc7519 a spp:GroundingSource ;
    dcterms:identifier "RFC 7519" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc7519> ;
    dcterms:title "IETF RFC 7519 — JSON Web Token (JWT)"@en ;
    spp:sourceTier "T1" .

sppsrc:rfc7807 a spp:GroundingSource ;
    dcterms:identifier "RFC 7807" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc7807> ;
    dcterms:title "IETF RFC 7807 — Problem Details for HTTP APIs"@en ;
    rdfs:comment "Obsoleted by RFC 9457; retained for the rfc7807 concept in sppc:error-envelope-kind."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc8032 a spp:GroundingSource ;
    dcterms:identifier "RFC 8032" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc8032> ;
    dcterms:title "IETF RFC 8032 — Edwards-Curve Digital Signature Algorithm (EdDSA)"@en ;
    rdfs:comment "Authoritative Ed25519 specification. Ground for ed25519 in sppc:webhook-signature-scheme."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc8259 a spp:GroundingSource ;
    dcterms:identifier "RFC 8259" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc8259> ;
    dcterms:title "IETF RFC 8259 — The JavaScript Object Notation (JSON) Data Interchange Format"@en ;
    rdfs:comment "Authoritative JSON specification. Ground for the json concept in sppc:wire-format."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc8446 a spp:GroundingSource ;
    dcterms:identifier "RFC 8446" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc8446> ;
    dcterms:title "IETF RFC 8446 — TLS 1.3"@en ;
    spp:sourceTier "T1" .

sppsrc:rfc8949 a spp:GroundingSource ;
    dcterms:identifier "RFC 8949" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc8949> ;
    dcterms:title "IETF RFC 8949 — Concise Binary Object Representation (CBOR)"@en ;
    rdfs:comment "Authoritative CBOR specification. Ground for the cbor concept in sppc:wire-format."@en ;
    spp:sourceTier "T1" .

sppsrc:rfc9111 a spp:GroundingSource ;
    dcterms:identifier "RFC 9111" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc9111> ;
    dcterms:title "IETF RFC 9111 — HTTP Caching"@en ;
    spp:sourceTier "T1" .

sppsrc:rfc9562 a spp:GroundingSource ;
    dcterms:identifier "RFC 9562" ;
    dcterms:source <https://www.rfc-editor.org/rfc/rfc9562> ;
    dcterms:title "IETF RFC 9562 — Universally Unique IDentifiers (UUIDs)"@en ;
    rdfs:comment "Obsoletes RFC 4122. Defines UUIDv6/v7/v8. Ground for uuid_v7 in sppc:id-generation-strategy."@en ;
    spp:sourceTier "T1" .

sppsrc:richardson-site a spp:GroundingSource ;
    dcterms:source <https://microservices.io/patterns/> ;
    dcterms:title "Richardson, C. microservices.io — companion site to Microservices Patterns"@en ;
    rdfs:comment "Online companion to Richardson 2018. Maintains URL slugs that the MSP catalog's altLabels mirror (e.g. /patterns/data/saga.html)."@en ;
    spp:sourceTier "T4" .

sppsrc:saml2 a spp:GroundingSource ;
    dcterms:identifier "OASIS SAML 2.0" ;
    dcterms:source <https://docs.oasis-open.org/security/saml/v2.0/> ;
    dcterms:title "OASIS SAML 2.0"@en ;
    spp:sourceTier "T1" .

sppsrc:scrum-guide a spp:GroundingSource ;
    dcterms:source <https://scrumguides.org/> ;
    dcterms:title "Scrum Guide (Schwaber & Sutherland 2020)"@en ;
    spp:sourceTier "T2" .

sppsrc:sigstore a spp:GroundingSource ;
    dcterms:source <https://www.sigstore.dev/> ;
    dcterms:title "Sigstore — software signing and verification (OpenSSF)"@en ;
    spp:sourceTier "T2" .

sppsrc:slsa a spp:GroundingSource ;
    dcterms:source <https://slsa.dev/> ;
    dcterms:title "SLSA — Supply-chain Levels for Software Artifacts (OpenSSF)"@en ;
    spp:sourceTier "T2" .

sppsrc:smith-1982 a spp:GroundingSource ;
    dcterms:identifier "10.1145/356887.356892" ;
    dcterms:title "Smith (1982). Cache memories"@en ;
    spp:sourceTier "T1" .

sppsrc:soc2 a spp:GroundingSource ;
    dcterms:source <https://www.aicpa-cima.com/topic/audit-assurance/audit-and-assurance-greater-than-soc-2> ;
    dcterms:title "AICPA SOC 2 — Trust Services Criteria"@en ;
    spp:sourceTier "T2" .

sppsrc:spanner-paper a spp:GroundingSource ;
    dcterms:identifier "OSDI 2012" ;
    dcterms:title "Corbett, J. C. et al. (2012). Spanner: Google's Globally-Distributed Database"@en ;
    rdfs:comment "Authoritative reference for globally-distributed-database read locality and TrueTime. Ground for read-locality concepts in sppc:read-locality."@en ;
    spp:sourceTier "T1" .

sppsrc:tofan-2014 a spp:GroundingSource ;
    dcterms:identifier "10.1016/j.infsof.2014.03.009" ;
    dcterms:title "Tofan, Galster, Avgeriou, Schuitema (2014). Past and future of software architectural decisions — A systematic mapping study"@en ;
    spp:sourceTier "T1" .

sppsrc:tyree-akerman-2005 a spp:GroundingSource ;
    dcterms:identifier "10.1109/MS.2005.27" ;
    dcterms:title "Tyree & Akerman (2005). Architecture Decisions: Demystifying Architecture"@en ;
    spp:sourceTier "T1" .

sppsrc:ulid-spec a spp:GroundingSource ;
    dcterms:source <https://github.com/ulid/spec> ;
    dcterms:title "ULID — Universally Unique Lexicographically Sortable Identifier"@en ;
    rdfs:comment "Project specification for the ULID identifier format. Ground for ulid in sppc:id-generation-strategy."@en ;
    spp:sourceTier "T2" .

sppsrc:vanheesch-2012 a spp:GroundingSource ;
    dcterms:identifier "10.1016/j.jss.2011.10.017" ;
    dcterms:title "van Heesch, Avgeriou, Hilliard (2012). A documentation framework for architecture decisions"@en ;
    spp:sourceTier "T1" .

sppsrc:vanheesch-2012-forces a spp:GroundingSource ;
    dcterms:identifier "10.1109/WICSA-ECSA.212.18" ;
    dcterms:title "van Heesch, Avgeriou, Hilliard (2012). Forces on Architecture Decisions — A Viewpoint"@en ;
    spp:sourceTier "T1" .

sppsrc:w3c-xml-1-0 a spp:GroundingSource ;
    dcterms:identifier "W3C XML 1.0 (Fifth Edition)" ;
    dcterms:source <https://www.w3.org/TR/xml/> ;
    dcterms:title "Extensible Markup Language (XML) 1.0 (Fifth Edition)"@en ;
    rdfs:comment "W3C XML 1.0 specification. Ground for xml in sppc:wire-format."@en ;
    spp:sourceTier "T1" .

sppsrc:wcag22 a spp:GroundingSource ;
    dcterms:identifier "W3C WCAG 2.2" ;
    dcterms:issued "2023-10-05"^^xsd:date ;
    dcterms:source <https://www.w3.org/TR/WCAG22/> ;
    dcterms:title "WCAG 2.2 — Web Content Accessibility Guidelines"@en ;
    spp:sourceTier "T1" .

sppsrc:wiggins-12factor a spp:GroundingSource ;
    dcterms:source <https://12factor.net/> ;
    dcterms:title "Wiggins (2011). The Twelve-Factor App"@en ;
    spp:sourceTier "T4" .

sppsrc:yaml-1-2 a spp:GroundingSource ;
    dcterms:identifier "YAML 1.2.2" ;
    dcterms:source <https://yaml.org/spec/1.2.2/> ;
    dcterms:title "YAML Ain't Markup Language (YAML) version 1.2"@en ;
    rdfs:comment "YAML 1.2 specification. Ground for yaml in sppc:wire-format."@en ;
    spp:sourceTier "T2" .

sppst:UNGROUNDED a skos:Concept ;
    skos:definition "No source. A defect to remediate."@en ;
    skos:inScheme sppc:grounding-status ;
    skos:prefLabel "UNGROUNDED"@en .

sppc:cmp-async-request-reply a skos:Concept ;
    skos:altLabel "Asynchronous Request-Reply pattern"@en ;
    skos:definition "Request/response over async messaging using a reply channel and correlation ID."@en ;
    skos:inScheme sppc:communication-pattern ;
    skos:prefLabel "Asynchronous Request/Reply"@en .

sppc:cmp-domain-specific-protocol a skos:Concept ;
    skos:definition "Use a standard protocol fitted to the domain (SMTP, MQTT, AMQP, etc.) rather than HTTP/messaging."@en ;
    skos:inScheme sppc:communication-pattern ;
    skos:prefLabel "Domain-specific protocol"@en .

sppc:cmp-idempotent-consumer a skos:Concept ;
    skos:definition "Process duplicate messages safely using a deduplication key or idempotency token."@en ;
    skos:inScheme sppc:communication-pattern ;
    skos:prefLabel "Idempotent Consumer"@en ;
    spp:tier sppt:T2 .

sppc:cmp-messaging a skos:Concept ;
    skos:altLabel "Async messaging"@en,
        "Pub/sub"@en,
        "Publisher-Subscriber pattern"@en ;
    skos:definition "Asynchronous communication via a broker; channels, topics, queues."@en ;
    skos:inScheme sppc:communication-pattern ;
    skos:prefLabel "Messaging"@en .

sppc:cmp-rpi a skos:Concept ;
    skos:altLabel "REST"@en,
        "RPI"@en,
        "Sync HTTP"@en,
        "gRPC"@en ;
    skos:definition "Synchronous request/response over the network (REST, gRPC, Thrift)."@en ;
    skos:inScheme sppc:communication-pattern ;
    skos:prefLabel "Remote Procedure Invocation"@en .

sppc:dcp-api-composition a skos:Concept ;
    skos:definition "Implement queries by invoking multiple services and joining their results in-memory."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "API Composition"@en ;
    spp:tier sppt:T2 .

sppc:dcp-cqrs a skos:Concept ;
    skos:altLabel "CQRS pattern"@en,
        "Command Query Responsibility Segregation"@en ;
    skos:definition "Separate read and write models. Read model often a materialized view of events from other services."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "CQRS"@en ;
    spp:tier sppt:T0 .

sppc:dcp-database-per-service a skos:Concept ;
    skos:altLabel "Database per Service"@en ;
    skos:definition "Each service owns its persistent state; no shared schemas/tables."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Database per Service"@en ;
    spp:tier sppt:T0 .

sppc:dcp-domain-event a skos:Concept ;
    skos:altLabel "Domain Event (DDD)"@en ;
    skos:definition "Publish an event when something noteworthy happens in a service's domain."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Domain Event"@en .

sppc:dcp-event-sourcing a skos:Concept ;
    skos:altLabel "Event Sourcing pattern"@en,
        "EventSourcing"@en ;
    skos:definition "Persist application state as an append-only log of domain events; current state is a fold over the log."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Event Sourcing"@en ;
    spp:tier sppt:T0 .

sppc:dcp-polling-publisher a skos:Concept ;
    skos:definition "Periodically poll the outbox table and publish unpublished entries."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Polling Publisher"@en .

sppc:dcp-shared-database a skos:Concept ;
    rdfs:comment "Listed as an anti-pattern in the MSP catalog (see sppc:cat-msp)."@en ;
    skos:definition "Multiple services share a single database. Listed in the catalog as an anti-pattern / pragmatic fallback."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Shared Database"@en .

sppc:dcp-transaction-log-tailing a skos:Concept ;
    skos:altLabel "CDC (Change Data Capture)"@en,
        "Debezium-style"@en ;
    skos:definition "Publish outbox entries by tailing the database transaction log (e.g., CDC)."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Transaction Log Tailing"@en .

sppc:dcp-transactional-outbox a skos:Concept ;
    skos:altLabel "Outbox"@en,
        "Outbox pattern"@en ;
    skos:definition "Atomically write business state and an outgoing message to the same database transaction; a separate process publishes the outbox."@en ;
    skos:inScheme sppc:data-consistency-pattern ;
    skos:prefLabel "Transactional Outbox"@en .

sppc:dep-adapter a skos:Concept ;
    skos:definition "Normalize a service's interface to the platform's expectations (monitoring shape, log format)."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Adapter"@en .

sppc:dep-ambassador a skos:Concept ;
    skos:altLabel "Ambassador pattern"@en ;
    skos:definition "Outbound proxy abstracting the network and remote-call concerns from the service."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Ambassador"@en .

sppc:dep-instance-per-container a skos:Concept ;
    skos:definition "Package each service as a container image (Docker, OCI)."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Service Instance per Container"@en .

sppc:dep-instance-per-host a skos:Concept ;
    skos:definition "One service instance per host for isolation."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Service Instance per Host"@en .

sppc:dep-instance-per-vm a skos:Concept ;
    skos:definition "Package each service as a VM image."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Service Instance per VM"@en .

sppc:dep-multiple-per-host a skos:Concept ;
    skos:definition "Pack several service instances onto the same host (process or co-located)."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Multiple Service Instances per Host"@en .

sppc:dep-platform a skos:Concept ;
    skos:definition "Use a deployment platform (Kubernetes, ECS, Nomad) to abstract infrastructure."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Service Deployment Platform"@en .

sppc:dep-serverless a skos:Concept ;
    skos:definition "Deploy as managed functions (FaaS): Lambda, Cloud Functions, Cloud Run."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Serverless Deployment"@en .

sppc:dep-service-mesh a skos:Concept ;
    skos:altLabel "Istio"@en,
        "Linkerd"@en,
        "Mesh"@en ;
    skos:definition "Sidecar-based control of L7 traffic, mTLS, retries, and policy (Istio, Linkerd, Consul)."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Service Mesh"@en ;
    spp:tier sppt:T1 .

sppc:dep-sidecar a skos:Concept ;
    skos:altLabel "Sidecar pattern"@en ;
    skos:definition "Auxiliary process colocated with the service (logging agent, proxy, TLS terminator)."@en ;
    skos:inScheme sppc:deployment-pattern ;
    skos:prefLabel "Sidecar"@en .

sppc:dp-by-business-capability a skos:Concept ;
    skos:altLabel "Decompose by business capability"@en ;
    skos:definition "Define services that correspond to business capabilities of the organization."@en ;
    skos:inScheme sppc:decomposition-pattern ;
    skos:prefLabel "Decompose by business capability"@en .

sppc:dp-by-subdomain a skos:Concept ;
    skos:altLabel "Subdomain (DDD)"@en ;
    skos:definition "Define services aligned to DDD subdomains (core / supporting / generic)."@en ;
    skos:inScheme sppc:decomposition-pattern ;
    skos:prefLabel "Decompose by subdomain"@en .

sppc:dp-self-contained-service a skos:Concept ;
    skos:definition "A service handles a synchronous request without synchronous calls to other services."@en ;
    skos:inScheme sppc:decomposition-pattern ;
    skos:prefLabel "Self-contained service"@en ;
    spp:tier sppt:T1 .

sppc:dp-service-per-team a skos:Concept ;
    skos:definition "Each team owns one service end-to-end; Conway's Law made explicit."@en ;
    skos:inScheme sppc:decomposition-pattern ;
    skos:prefLabel "Service per team"@en .

sppc:dsv-client-side a skos:Concept ;
    skos:definition "Client queries the service registry and load-balances locally."@en ;
    skos:inScheme sppc:discovery-pattern ;
    skos:prefLabel "Client-side discovery"@en .

sppc:dsv-self-registration a skos:Concept ;
    skos:definition "Service instance registers and deregisters itself with the registry."@en ;
    skos:inScheme sppc:discovery-pattern ;
    skos:prefLabel "Self-registration"@en .

sppc:dsv-server-side a skos:Concept ;
    skos:definition "A router/load balancer queries the registry on the client's behalf."@en ;
    skos:inScheme sppc:discovery-pattern ;
    skos:prefLabel "Server-side discovery"@en .

sppc:dsv-service-registry a skos:Concept ;
    skos:definition "Database of available service instances (Eureka, Consul, etcd, K8s API)."@en ;
    skos:inScheme sppc:discovery-pattern ;
    skos:prefLabel "Service Registry"@en .

sppc:dsv-third-party-registration a skos:Concept ;
    skos:definition "An external registrar (the platform) handles registration/deregistration."@en ;
    skos:inScheme sppc:discovery-pattern ;
    skos:prefLabel "Third-party registration"@en .

sppc:gateway-pattern a skos:ConceptScheme ;
    dcterms:title "Gateway Pattern"@en ;
    rdfs:comment "External-API gateway patterns: aggregation, per-client BFF."@en ;
    skos:hasTopConcept sppc:gwp-api-gateway,
        sppc:gwp-backend-for-frontend ;
    spp:axisPosition spp:axisScope ;
    spp:groundedIn sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T1 .

sppc:gwp-api-gateway a skos:Concept ;
    skos:altLabel "Edge service"@en,
        "Gateway Aggregation pattern"@en,
        "Gateway Offloading pattern"@en,
        "Gateway Routing pattern"@en ;
    skos:definition "Single entry point that routes, aggregates, and protects backend services."@en ;
    skos:inScheme sppc:gateway-pattern ;
    skos:prefLabel "API Gateway"@en .

sppc:gwp-backend-for-frontend a skos:Concept ;
    skos:altLabel "BFF"@en,
        "Backends for Frontends pattern"@en,
        "BackendsForFrontends"@en ;
    skos:definition "A gateway specialized per client type (web, iOS, Android, partner)."@en ;
    skos:inScheme sppc:gateway-pattern ;
    skos:prefLabel "Backend for Frontend"@en ;
    spp:groundedIn sppsrc:fowler-poeaa .

sppc:idem-all-commands a skos:Concept ;
    skos:altLabel "all_commands"@en ;
    skos:definition "Every mutating command requires an idempotency key; the runtime dedupes replays within the dedup window."@en ;
    skos:inScheme sppc:idempotency-key-policy ;
    skos:prefLabel "All commands"@en .

sppc:idem-at-least-once a skos:Concept ;
    skos:altLabel "at_least_once"@en ;
    skos:inScheme sppc:delivery-guarantee ;
    skos:prefLabel "At-least-once"@en .

sppc:idem-at-most-once a skos:Concept ;
    skos:altLabel "at_most_once"@en ;
    skos:inScheme sppc:delivery-guarantee ;
    skos:prefLabel "At-most-once"@en .

sppc:idem-compensable a skos:Concept ;
    skos:inScheme sppc:idempotency-policy ;
    skos:prefLabel "Compensable transaction (Saga / TCC)"@en ;
    skos:related sppc:dcp-saga .

sppc:idem-exactly-once a skos:Concept ;
    skos:altLabel "exactly_once"@en ;
    skos:inScheme sppc:delivery-guarantee ;
    skos:prefLabel "Exactly-once (via dedup + transactional log)"@en .

sppc:idem-explicit-per-command a skos:Concept ;
    skos:altLabel "explicit_per_command"@en ;
    skos:definition "Idempotency-key handling is opt-in per command, declared on the command itself."@en ;
    skos:inScheme sppc:idempotency-key-policy ;
    skos:prefLabel "Explicit per command"@en .

sppc:idem-idempotent-by-key a skos:Concept ;
    skos:altLabel "idempotent_by_key"@en ;
    skos:inScheme sppc:idempotency-key-policy ;
    skos:prefLabel "Idempotent by key"@en .

sppc:idem-off a skos:Concept ;
    skos:altLabel "off"@en ;
    skos:definition "No idempotency-key handling. Replays produce duplicate effects."@en ;
    skos:inScheme sppc:idempotency-key-policy ;
    skos:prefLabel "Off"@en .

sppc:idempotency-policy a skos:ConceptScheme ;
    dcterms:title "Idempotency Policy (legacy umbrella)"@en ;
    rdfs:comment "ADDED in v4.0 per research Part 3.3. CR-002 r1.1 split this scheme into sppc:delivery-guarantee and sppc:idempotency-key-policy; the umbrella retains the compensable-transaction concept which belongs to neither sub-scheme. New instances should prefer the sub-schemes; this umbrella is kept to avoid breaking existing references."@en ;
    skos:hasTopConcept sppc:idem-compensable ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:helland-2012,
        sppsrc:kleppmann-ddia ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:maint-corrective a skos:Concept ;
    skos:inScheme sppc:maintenance-type ;
    skos:prefLabel "Corrective"@en .

sppc:mcp-externalized-configuration a skos:Concept ;
    skos:altLabel "12-factor config"@en,
        "External Configuration Store pattern"@en ;
    skos:definition "Configuration loaded at startup from environment/config service, not baked into the artifact."@en ;
    skos:inScheme sppc:microservice-chassis-pattern ;
    skos:prefLabel "Externalized Configuration"@en .

sppc:mcp-microservice-chassis a skos:Concept ;
    skos:definition "Framework handling cross-cutting concerns: config, logging, metrics, tracing, discovery."@en ;
    skos:inScheme sppc:microservice-chassis-pattern ;
    skos:prefLabel "Microservice Chassis"@en .

sppc:mcp-service-template a skos:Concept ;
    skos:definition "Scaffold for new services with chassis and standards pre-wired."@en ;
    skos:inScheme sppc:microservice-chassis-pattern ;
    skos:prefLabel "Service Template"@en .

sppc:obp-application-metrics a skos:Concept ;
    skos:definition "Expose counters, gauges, and histograms to a metrics backend (Prometheus, StatsD)."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Application Metrics"@en .

sppc:obp-audit-logging a skos:Concept ;
    skos:definition "Record significant user/business actions for compliance and forensics."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Audit Logging"@en .

sppc:obp-distributed-tracing a skos:Concept ;
    skos:altLabel "OpenTelemetry"@en,
        "Tracing"@en ;
    skos:definition "Propagate trace and span context across service hops (W3C trace-context, OpenTelemetry)."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Distributed Tracing"@en .

sppc:obp-exception-tracking a skos:Concept ;
    skos:definition "Centralized exception capture and deduplication (Sentry-style)."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Exception Tracking"@en .

sppc:obp-health-check-api a skos:Concept ;
    skos:altLabel "Health Endpoint Monitoring pattern"@en ;
    skos:definition "Liveness/readiness endpoints consumed by orchestrators and load balancers."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Health Check API"@en .

sppc:obp-log-aggregation a skos:Concept ;
    skos:definition "Centralize logs from all services (ELK, Loki, Splunk)."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Log Aggregation"@en .

sppc:obp-log-deployments-and-changes a skos:Concept ;
    skos:definition "Record deployment and config-change events to correlate with incidents."@en ;
    skos:inScheme sppc:observability-pattern ;
    skos:prefLabel "Log deployments and changes"@en .

sppc:operation-purity a skos:ConceptScheme ;
    dcterms:title "Operation purity"@en ;
    rdfs:comment "Findings §3.2: declares whether an operation is pure or effectful."@en ;
    skos:hasTopConcept sppc:op-effectful,
        sppc:op-pure ;
    spp:axisPosition spp:axisConcern ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:tier sppt:T1 .

sppc:pii-restricted a skos:Concept ;
    skos:definition "Information whose disclosure is restricted to a defined audience and which requires elevated controls but does not meet the regulatory threshold of GDPR Art. 9 special-category data. Classification level from the backend-spec PIIClassification enum."@en ;
    skos:inScheme sppc:pii-classification ;
    skos:prefLabel "restricted"@en ;
    skos:related sppc:pii-sensitive .

sppc:pii-sensitive a skos:Concept ;
    skos:definition "Special-category personal data per GDPR Art. 9 (health, biometrics, religion, sexuality, political opinion, etc.). Roughly analogous to the backend-spec `restricted` level but grounded in a stricter regulatory frame; see skos:related."@en ;
    skos:inScheme sppc:pii-classification ;
    skos:prefLabel "sensitive"@en ;
    skos:related sppc:pii-restricted .

sppc:refactoring-pattern a skos:ConceptScheme ;
    dcterms:title "Refactoring Pattern"@en ;
    rdfs:comment "Refactoring strategies for migrating from monolith to microservices."@en ;
    skos:hasTopConcept sppc:rfp-anti-corruption-layer,
        sppc:rfp-strangler-fig ;
    spp:axisPosition spp:axisPhase ;
    spp:groundedIn sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T2 .

sppc:rfp-anti-corruption-layer a skos:Concept ;
    skos:altLabel "ACL"@en,
        "Anti-Corruption Layer pattern"@en ;
    skos:definition "Translation layer isolating new services from legacy semantics."@en ;
    skos:inScheme sppc:refactoring-pattern ;
    skos:prefLabel "Anti-Corruption Layer"@en ;
    spp:groundedIn sppsrc:evans-2003 .

sppc:rfp-strangler-fig a skos:Concept ;
    skos:altLabel "Strangler"@en,
        "Strangler Application"@en,
        "Strangler Fig pattern"@en,
        "Strangler Pattern"@en,
        "StranglerFigApplication"@en ;
    skos:definition "Incrementally replace monolith functionality behind a façade until the old system is dead."@en ;
    skos:inScheme sppc:refactoring-pattern ;
    skos:prefLabel "Strangler Fig"@en ;
    spp:groundedIn sppsrc:fowler-poeaa .

sppc:rsp-bulkhead a skos:Concept ;
    skos:altLabel "Bulkhead pattern"@en ;
    skos:definition "Partition resources (threads, connections) so one dependency failure cannot exhaust the whole service."@en ;
    skos:inScheme sppc:resilience-pattern ;
    skos:prefLabel "Bulkhead"@en ;
    spp:groundedIn sppsrc:nygard-2018 .

sppc:rsp-circuit-breaker a skos:Concept ;
    skos:altLabel "Circuit Breaker pattern"@en,
        "CircuitBreaker"@en ;
    skos:definition "Fail fast on a struggling dependency; auto-trip and auto-recover."@en ;
    skos:inScheme sppc:resilience-pattern ;
    skos:prefLabel "Circuit Breaker"@en ;
    spp:groundedIn sppsrc:nygard-2018 .

sppc:rsp-rate-limiting a skos:Concept ;
    skos:altLabel "Rate Limiting pattern"@en,
        "Throttling"@en,
        "Throttling pattern"@en ;
    skos:definition "Cap the request rate accepted by a service to protect it from overload."@en ;
    skos:inScheme sppc:resilience-pattern ;
    skos:prefLabel "Rate Limiting"@en ;
    spp:tier sppt:T3 .

sppc:rsp-retry a skos:Concept ;
    skos:altLabel "Retry pattern"@en ;
    skos:definition "Re-attempt a failed call with backoff and jitter to absorb transient faults."@en ;
    skos:inScheme sppc:resilience-pattern ;
    skos:prefLabel "Retry"@en ;
    spp:tier sppt:T3 .

sppc:rsp-steady-state a skos:Concept ;
    skos:definition "Services must not consume unbounded resources (logs, memory, sessions) over time."@en ;
    skos:inScheme sppc:resilience-pattern ;
    skos:prefLabel "Steady State"@en ;
    spp:groundedIn sppsrc:nygard-2018 ;
    spp:tier sppt:T3 .

sppc:rsp-timeout a skos:Concept ;
    skos:definition "Bound the time a caller waits on a remote dependency."@en ;
    skos:inScheme sppc:resilience-pattern ;
    skos:prefLabel "Timeout"@en ;
    spp:groundedIn sppsrc:nygard-2018 ;
    spp:tier sppt:T3 .

sppc:scp-access-token a skos:Concept ;
    skos:altLabel "JWT auth"@en,
        "OAuth bearer token"@en ;
    skos:definition "Services validate signed tokens (e.g., JWT) issued by an identity provider."@en ;
    skos:inScheme sppc:security-pattern ;
    skos:prefLabel "Access Token"@en .

sppc:scp-identity-propagation a skos:Concept ;
    skos:altLabel "Federated Identity pattern"@en ;
    skos:definition "Caller identity is forwarded through the call chain so downstream services can authorize."@en ;
    skos:inScheme sppc:security-pattern ;
    skos:prefLabel "Identity Propagation"@en .

sppc:security-pattern a skos:ConceptScheme ;
    dcterms:title "Security Pattern"@en ;
    rdfs:comment "Microservices security patterns: token-based auth, identity propagation."@en ;
    skos:hasTopConcept sppc:scp-access-token,
        sppc:scp-identity-propagation ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T1 .

sppc:tsp-consumer-driven-contract a skos:Concept ;
    skos:altLabel "CDCT"@en,
        "Pact tests"@en ;
    skos:definition "Consumers publish expectations the provider verifies (Pact)."@en ;
    skos:inScheme sppc:testing-pattern ;
    skos:prefLabel "Consumer-Driven Contract Test"@en .

sppc:tsp-consumer-side-contract a skos:Concept ;
    skos:definition "Consumer tests against a provider contract/stub independently."@en ;
    skos:inScheme sppc:testing-pattern ;
    skos:prefLabel "Consumer-Side Contract Test"@en .

sppc:tsp-service-component a skos:Concept ;
    skos:definition "Test a service in isolation with all external collaborators stubbed."@en ;
    skos:inScheme sppc:testing-pattern ;
    skos:prefLabel "Service Component Test"@en .

sppc:ui-composition-pattern a skos:ConceptScheme ;
    dcterms:title "Ui Composition Pattern"@en ;
    rdfs:comment "UI-composition patterns: server-side, client-side (micro-frontends)."@en ;
    skos:hasTopConcept sppc:uic-client-side-composition,
        sppc:uic-server-side-composition ;
    spp:axisPosition spp:axisScope ;
    spp:groundedIn sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T2 .

sppc:uic-client-side-composition a skos:Concept ;
    skos:altLabel "Micro-frontends"@en,
        "MicroFrontends"@en ;
    skos:definition "Browser composes UI from multiple services. Often called micro-frontends."@en ;
    skos:inScheme sppc:ui-composition-pattern ;
    skos:prefLabel "Client-side UI composition"@en .

sppc:uic-server-side-composition a skos:Concept ;
    skos:definition "Assemble HTML on the server by composing fragments from multiple services."@en ;
    skos:inScheme sppc:ui-composition-pattern ;
    skos:prefLabel "Server-side page fragment composition"@en .

spp:Enumeration a owl:Class ;
    rdfs:label "Enumeration"@en ;
    rdfs:comment "A named finite value set available to fields and state machines."@en ;
    rdfs:subClassOf spp:TypeDecl ;
    spp:groundedIn sppsrc:iso19505-2-2012 .

spp:PrimitiveType a owl:Class ;
    rdfs:label "Primitive Type"@en ;
    rdfs:comment "A named primitive type alias with a base primitive and optional constraints."@en ;
    rdfs:subClassOf spp:TypeDecl ;
    spp:groundedIn sppsrc:iso19505-2-2012 .

spp:extensible a skos:Concept ;
    skos:definition """Third parties may register named extension schemes
        whose concepts declare skos:broader to a concept in this scheme.
        Base concepts remain fixed. Registered extensions are listed in
        sppc:extension-registry."""@en ;
    skos:inScheme sppc:scheme-openness ;
    skos:prefLabel "Extensible"@en .

spp:objectAuthRule a owl:DatatypeProperty ;
    rdfs:comment """Object-level authorization predicate. Examined for input.*
        vs target.*/result.* references to determine pre- vs post-fetch position
        in the aspect stack. Closes OWASP API1:2023."""@en ;
    rdfs:range xsd:string .

spp:open a skos:Concept ;
    skos:definition """Per-project additions allowed inline. Concept IRI
        must follow the scheme's documented naming convention. Precedent:
        sppc:synthetic-error-key uses lowercase_snake_case keys."""@en ;
    skos:inScheme sppc:scheme-openness ;
    skos:prefLabel "Open"@en .

spp:operationAnonymous a owl:DatatypeProperty ;
    rdfs:comment "True when the operation requires no authorization (in-process, anonymous public, etc.)."@en ;
    rdfs:range xsd:boolean .

spp:operationPurity a owl:ObjectProperty ;
    rdfs:comment """Findings §3.2 closure: declares whether an operation is pure
        (no I/O, deterministic, side-effect-free) or effectful. Pure operations
        skip auth, idempotency, transactions, and version checks at codegen."""@en ;
    rdfs:range skos:Concept .

spp:operationRequiredScope a owl:DatatypeProperty ;
    rdfs:comment "Required OAuth/OIDC scope. Required when operation is not anonymous."@en ;
    rdfs:range xsd:string .

spp:planVersion a owl:DatatypeProperty ;
    rdfs:label "plan version"@en ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range xsd:string .

spp:privacyPosture a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range skos:Concept .

spp:sbomPolicy a owl:ObjectProperty ;
    rdfs:domain spp:SoftwareProjectPlan ;
    rdfs:range skos:Concept .

sppsrc:beck-2003-tdd a spp:GroundingSource ;
    dcterms:identifier "ISBN:0-321-14653-0" ;
    dcterms:title "Beck (2003). Test-Driven Development by Example. Addison-Wesley."@en ;
    spp:sourceTier "T4" .

sppsrc:bezos-2015 a spp:GroundingSource ;
    dcterms:source <https://www.aboutamazon.com/news/company-news/2015-letter-to-shareholders> ;
    dcterms:title "Bezos, J. (2015). Amazon Shareholder Letter (one-way/two-way doors)"@en ;
    spp:sourceTier "T4" .

sppsrc:codd-1970 a spp:GroundingSource ;
    dcterms:identifier "10.1145/362384.362685" ;
    dcterms:title "Codd (1970). A relational model of data for large shared data banks"@en ;
    spp:sourceTier "T1" .

sppsrc:google-sre a spp:GroundingSource ;
    dcterms:identifier "ISBN:1-4919-2912-X" ;
    dcterms:source <https://sre.google/books/> ;
    dcterms:title "Beyer et al. (2016). Site Reliability Engineering"@en ;
    spp:sourceTier "T4" .

sppsrc:harel-1987 a spp:GroundingSource ;
    dcterms:identifier "10.1016/0167-6423(87)90035-9" ;
    dcterms:title "Harel, D. (1987). Statecharts: A Visual Formalism for Complex Systems"@en ;
    rdfs:comment "Foundational paper for hierarchical state machines; later incorporated into UML."@en ;
    spp:sourceTier "T1" .

sppsrc:hilton-2016 a spp:GroundingSource ;
    dcterms:identifier "10.1145/2970276.2970358" ;
    dcterms:title "Hilton et al. (2016). Usage, costs, and benefits of CI in open-source projects"@en ;
    spp:sourceTier "T1" .

sppsrc:hoare-1969 a spp:GroundingSource ;
    dcterms:identifier "10.1145/363235.363259" ;
    dcterms:title "Hoare, C. A. R. (1969). An Axiomatic Basis for Computer Programming"@en ;
    rdfs:comment "Hoare logic: preconditions, postconditions, invariants — the mathematical basis for spp:Invariant."@en ;
    spp:sourceTier "T1" .

sppsrc:humble-farley-cd a spp:GroundingSource ;
    dcterms:identifier "ISBN:0-321-60191-2" ;
    dcterms:title "Humble & Farley (2010). Continuous Delivery"@en ;
    spp:sourceTier "T4" .

sppsrc:istqb a spp:GroundingSource ;
    dcterms:source <https://glossary.istqb.org/> ;
    dcterms:title "ISTQB Glossary of Testing Terms"@en ;
    spp:sourceTier "T2" .

sppsrc:liskov-wing-1994 a spp:GroundingSource ;
    dcterms:identifier "10.1145/197320.197383" ;
    dcterms:title "Liskov, B. & Wing, J. (1994). A Behavioural Notion of Subtyping"@en ;
    rdfs:comment "ACM TOPLAS 16(6). Substitutability via pre/postcondition contracts."@en ;
    spp:sourceTier "T1" .

sppsrc:nist-privacy-framework a spp:GroundingSource ;
    dcterms:source <https://www.nist.gov/privacy-framework> ;
    dcterms:title "NIST Privacy Framework v1.0"@en ;
    spp:sourceTier "T1" .

sppsrc:ntia-sbom a spp:GroundingSource ;
    dcterms:source <https://www.ntia.gov/blog/2021/ntia-releases-minimum-elements-software-bill-materials> ;
    dcterms:title "NTIA (2021). The Minimum Elements for an SBOM"@en ;
    spp:sourceTier "T2" .

sppsrc:opentelemetry a spp:GroundingSource ;
    dcterms:source <https://opentelemetry.io/docs/specs/otel/> ;
    dcterms:title "OpenTelemetry Specification (CNCF Graduated)"@en ;
    spp:sourceTier "T1" .

sppsrc:semver a spp:GroundingSource ;
    dcterms:identifier "SemVer 2.0.0" ;
    dcterms:source <https://semver.org/spec/v2.0.0.html> ;
    dcterms:title "Semantic Versioning 2.0.0"@en ;
    spp:sourceTier "T2" .

sppsrc:spdx-iso5962 a spp:GroundingSource ;
    dcterms:identifier "ISO/IEC 5962:2021" ;
    dcterms:title "SPDX Specification (ISO/IEC 5962:2021)"@en ;
    spp:sourceTier "T1" .

sppc:auth-scheme-kind a skos:ConceptScheme ;
    dcterms:title "Authorization scheme kind"@en ;
    rdfs:comment """Enumeration of authorization scheme kinds available to a
        component. Member set is a starter
        enumeration covering the most common in-process / single-host
        patterns; it is NOT exhaustive — distributed identity-provider
        flows (OAuth 2.x, OIDC, mTLS, SPIFFE) are deliberately out of
        scope here and belong in a separate scheme. Axis position and
        reversibility tier are intentionally unset: a definitive
        positioning is open work pending review by the working group;
        consumers should not assume any particular axis/tier
        assignment for this scheme."""@en ;
    skos:hasTopConcept sppc:auth-none,
        sppc:auth-os-permissions,
        sppc:auth-token-env-var ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY .

sppc:delivery-guarantee a skos:ConceptScheme ;
    dcterms:title "Delivery Guarantee"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Message-delivery semantics for subscriptions, webhooks, and side-effect emission. Backend-spec Subscription.delivery_guarantee enum."@en ;
    skos:hasTopConcept sppc:idem-at-least-once,
        sppc:idem-at-most-once,
        sppc:idem-exactly-once ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:helland-2012,
        sppsrc:kleppmann-ddia ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:entity-lifecycle a skos:ConceptScheme ;
    dcterms:title "Entity lifecycle"@en ;
    rdfs:comment "Findings §3.1: declares persistence/ephemerality of entities."@en ;
    skos:hasTopConcept sppc:el-ephemeral,
        sppc:el-persistent,
        sppc:el-session ;
    spp:axisPosition spp:axisConcern ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL ;
    spp:tier sppt:T1 .

sppc:invariant-enforcement-timing a skos:ConceptScheme ;
    dcterms:title "Invariant Enforcement Timing"@en ;
    rdfs:comment "ADDED CR-002 r1.1. When the runtime checks an invariant relative to the mutation that could violate it. Backend-spec Invariant.enforcement_timing enum."@en ;
    skos:hasTopConcept sppc:iet-deferred-to-commit,
        sppc:iet-eager,
        sppc:iet-eventually-consistent ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:evans-2003,
        sppsrc:helland-2012 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:microservice-chassis-pattern a skos:ConceptScheme ;
    dcterms:title "Microservice Chassis Pattern"@en ;
    rdfs:comment "Microservice chassis patterns: cross-cutting framework concerns (config, logging, metrics scaffold)."@en ;
    skos:hasTopConcept sppc:mcp-externalized-configuration,
        sppc:mcp-microservice-chassis,
        sppc:mcp-service-template ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T2 .

sppc:migration-strategy a skos:ConceptScheme ;
    dcterms:title "Schema Migration Strategy"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Strategy for evolving the persistent schema across versions. Backend-spec MigrationConfig.strategy enum. Distinct from sppc:rollback-policy (runtime deploy rollback)."@en ;
    skos:hasTopConcept sppc:ms-forward-and-rollback,
        sppc:ms-forward-only,
        sppc:ms-greenfield-only ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:ambler-sadalage-2006,
        sppsrc:backend-spec-v1-1-0 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:pagination-style a skos:ConceptScheme ;
    dcterms:title "Pagination Style"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Pagination strategy for list queries. Backend-spec Pagination.style enum."@en ;
    skos:hasTopConcept sppc:ps-cursor,
        sppc:ps-none,
        sppc:ps-offset ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:kleppmann-ddia ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:read-locality a skos:ConceptScheme ;
    dcterms:title "Read Locality"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Policy for which region serves read traffic. Backend-spec MultiRegionConfig.read_locality enum."@en ;
    skos:hasTopConcept sppc:rl-any-region,
        sppc:rl-follower-reads-allowed,
        sppc:rl-home-region-only ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:cockroachdb-docs,
        sppsrc:kleppmann-ddia,
        sppsrc:spanner-paper ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:replication-mode a skos:ConceptScheme ;
    dcterms:title "Replication Mode"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Synchronicity policy for cross-region data replication. Backend-spec MultiRegionConfig.replication enum."@en ;
    skos:hasTopConcept sppc:rm-async,
        sppc:rm-none,
        sppc:rm-sync ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:kleppmann-ddia ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:retry-backoff a skos:ConceptScheme ;
    dcterms:title "Retry Backoff Strategy"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Backoff curve for retry attempts. Backend-spec RetryPolicy.backoff enum."@en ;
    skos:hasTopConcept sppc:rb-exponential,
        sppc:rb-fixed,
        sppc:rb-linear ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:nygard-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:tier sppt:T2 .

sppc:sbom-format a skos:ConceptScheme ;
    dcterms:title "SBOM Format"@en ;
    skos:hasTopConcept sppc:sbom-cyclonedx,
        sppc:sbom-spdx,
        sppc:sbom-swid ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:cyclonedx,
        sppsrc:ntia-sbom,
        sppsrc:spdx-iso5962 ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
    spp:tier sppt:T1 .

sppc:scheme-openness a skos:ConceptScheme,
        spp:MetaScheme ;
    dcterms:title "Scheme openness"@en ;
    rdfs:comment "The three openness modes a ConceptScheme may declare."@en ;
    skos:hasTopConcept spp:closed,
        spp:extensible,
        spp:open ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL .

sppc:testing-pattern a skos:ConceptScheme ;
    dcterms:title "Testing Pattern"@en ;
    rdfs:comment "Microservices testing patterns: contract testing, service-component testing."@en ;
    skos:hasTopConcept sppc:tsp-consumer-driven-contract,
        sppc:tsp-consumer-side-contract,
        sppc:tsp-service-component ;
    spp:axisPosition spp:axisPhase ;
    spp:groundedIn sppsrc:richardson-2018 ;
    spp:groundingStatus sppst:PRACTITIONER_ONLY ;
    spp:schemeOpenness spp:closed ;
    spp:tier sppt:T3 .

sppc:write-conflict-policy a skos:ConceptScheme ;
    dcterms:title "Write-Conflict Policy"@en ;
    rdfs:comment "ADDED CR-002 r1.1. Policy for resolving concurrent writes to the same aggregate. Backend-spec ConcurrencyPolicy.default enum. Orthogonal to sppc:concurrency-model (runtime concurrency model)."@en ;
    skos:hasTopConcept sppc:wcp-last-write-wins,
        sppc:wcp-optimistic-versioning,
        sppc:wcp-pessimistic-lock ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:backend-spec-v1-1-0,
        sppsrc:bernstein-hadzilacos-goodman-1987,
        sppsrc:kleppmann-ddia ;
    spp:groundingStatus sppst:FORMALLY_GROUNDED ;
