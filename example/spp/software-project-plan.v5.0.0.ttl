spp:ErrorClass a owl:Class ;
    rdfs:label "Error Class"@en ;
    rdfs:comment "A named error category with default HTTP status (4xx/5xx, RFC 9110) and retryability flag. Wire shape per RFC 9457 problem+json."@en ;
    spp:groundedIn sppsrc:nygard-2018,
        sppsrc:rfc9110,
        sppsrc:rfc9457 .

spp:axisScope a spp:Axis ;
    rdfs:label "Scope axis"@en ;
    rdfs:comment "What part of the system the decision binds."@en ;
    spp:groundedIn sppsrc:iso42010-2022,
        sppsrc:kruchten-1995-4plus1 ;
    spp:groundingStatus sppst:FRAMEWORK_INTERNAL .

sppt:T0 a skos:Concept ;
    skos:definition "Irreversible without a rewrite, a customer-breaking change, or a regulatory event."@en ;
    skos:inScheme sppc:reversibility-tier ;
    skos:prefLabel "T0 — Foundational"@en .

sppsrc:richardson-2018 a spp:GroundingSource ;
    dcterms:identifier "ISBN:978-1-61729-454-9" ;
    dcterms:title "Richardson, C. (2018). Microservices Patterns: With Examples in Java"@en ;
    rdfs:comment "Canonical practitioner catalog of microservices patterns: decomposition, data management (Saga family), communication (idempotent consumer, messaging), gateway, discovery, reliability, deployment, testing, observability, chassis. Ground for sppc:cat-msp."@en ;
    spp:sourceTier "T4" .

sppc:project-kind a skos:ConceptScheme ;
    dcterms:title "Project Kind"@en ;
    rdfs:comment "What the project fundamentally is. T0: changes here imply a different artefact entirely. SEMAT Essence notes that project kinds are NOT universal; this enum is practitioner consensus."@en ;
    skos:hasTopConcept sppc:pk-application,
        sppc:pk-cli,
        sppc:pk-daemon,
        sppc:pk-dataset,
        sppc:pk-documentation,
        sppc:pk-framework,
        sppc:pk-infra-module,
        sppc:pk-library,
        sppc:pk-mobile-app,
        sppc:pk-model,
        sppc:pk-plugin,
        sppc:pk-sdk,
        sppc:pk-service,
        sppc:pk-web-app ;
    spp:axisPosition spp:axisConcern ;
    spp:groundedIn sppsrc:jacobson-2012,
        sppsrc:omg-essence ;
    spp:groundingStatus sppst:PARTIALLY_GROUNDED ;
    spp:tier sppt:T0 .

spp:closed a skos:Concept ;
