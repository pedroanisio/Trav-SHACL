        spp:MetaScheme ;
    dcterms:title "Grounding status"@en ;
    skos:hasTopConcept sppst:FORMALLY_GROUNDED,
        sppst:FRAMEWORK_INTERNAL,
        sppst:PARTIALLY_GROUNDED,
        sppst:PRACTITIONER_ONLY,
        sppst:UNGROUNDED .

