spp:ErrorEnvelope a owl:Class ;
    rdfs:label "Error Envelope"@en ;
    rdfs:comment "The declared wire envelope for errors, including RFC 9457 problem details or another named format."@en ;
    spp:groundedIn sppsrc:rfc9457 .

spp:IndexDecl a owl:Class .

spp:Invariant a owl:Class ;
    rdfs:label "Invariant"@en ;
    rdfs:comment "A predicate that must hold of every persisted aggregate instance at every command boundary. Hoare-logic invariant."@en ;
    spp:groundedIn sppsrc:hoare-1969,
        sppsrc:liskov-wing-1994 .

spp:PolymorphismDecl a owl:Class ;
    rdfs:label "Polymorphism Declaration"@en ;
    rdfs:comment "A tagged-polymorphism declaration: base type, discriminator field, and declared variants."@en ;
    spp:groundedIn sppsrc:iso19505-2-2012 .

spp:Saga a owl:Class ;
    rdfs:label "Saga"@en ;
    rdfs:comment "A long-lived consistency workflow: a trigger event followed by ordered local transactions and optional compensations."@en ;
    spp:groundedIn sppsrc:garcia-molina-salem-1987,
        sppsrc:vernon-2013 .

spp:ServiceLevelObjective a owl:Class .

spp:SoftDeleteDecl a owl:Class ;
    rdfs:label "Soft Delete Declaration"@en ;
    rdfs:comment "A plan-time declaration that an entity is deleted by tombstone field rather than physical removal, with optional retention duration."@en ;
    spp:groundedIn sppsrc:evans-2003,
        sppsrc:vernon-2013 .

spp:Transition a owl:Class ;
    rdfs:label "Transition"@en ;
    rdfs:comment "A declared edge in a state machine: (from_states) --trigger--> to_state."@en ;
    spp:groundedIn sppsrc:harel-1987,
        sppsrc:iso19505-2-2012 .

spp:typeName a owl:DatatypeProperty ;
    rdfs:domain spp:TypeDecl ;
    rdfs:range xsd:string .

sppsrc:iso42010-2022 a spp:GroundingSource ;
    dcterms:identifier "ISO/IEC/IEEE 42010:2022" ;
    dcterms:issued "2022"^^xsd:gYear ;
    dcterms:source <https://www.iso.org/standard/74393.html> ;
    dcterms:title "ISO/IEC/IEEE 42010:2022 — Architecture description"@en ;
