sppc:wss-ed25519 a skos:Concept ;
    skos:definition "EdDSA digital signature using the Ed25519 curve per RFC 8032. Public-key verification on the receiver side."@en ;
    skos:inScheme sppc:webhook-signature-scheme ;
    skos:prefLabel "ed25519"@en .

sppc:wss-hmac-sha256 a skos:Concept ;
    skos:definition "HMAC-SHA256 keyed message authentication per RFC 2104 with SHA-256 as the underlying hash."@en ;
    skos:inScheme sppc:webhook-signature-scheme ;
    skos:prefLabel "hmac_sha256"@en .

sppc:wss-hmac-sha512 a skos:Concept ;
    skos:definition "HMAC-SHA512 keyed message authentication per RFC 2104 with SHA-512 as the underlying hash."@en ;
    skos:inScheme sppc:webhook-signature-scheme ;
    skos:prefLabel "hmac_sha512"@en .

sppc:wss-none a skos:Concept ;
    skos:definition "No signature. Receivers cannot cryptographically verify webhook authenticity. Generally unsafe."@en ;
    skos:inScheme sppc:webhook-signature-scheme ;
    skos:prefLabel "none"@en .

