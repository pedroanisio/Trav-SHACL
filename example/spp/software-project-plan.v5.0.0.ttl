    rdfs:range skos:Concept .

spp:commandEffectPolarity a owl:ObjectProperty ;
    rdfs:label "Effect polarity (explicit override)"@en ;
    rdfs:comment """Optional explicit polarity declaration. When absent, polarity
        is derived from spp:commandEffectOp by the default table documented in
        spp-v0_5_1-changelog.md §2.1. Authors should declare explicitly whenever
        the default is wrong — e.g., a sppc:effect-create command that sends an
        email is mutating_terminal, not mutating_reversible."""@en ;
    rdfs:domain spp:Command ;
    rdfs:range skos:Concept .

spp:commandEmits a owl:ObjectProperty ;
    rdfs:domain spp:Command ;
    rdfs:range spp:Event .

spp:commandError a owl:ObjectProperty ;
