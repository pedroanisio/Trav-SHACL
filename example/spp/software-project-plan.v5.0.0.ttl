        sppsrc:vernon-2013 .

spp:MetaScheme a owl:Class ;
    rdfs:label "Meta concept scheme"@en ;
    rdfs:comment """A concept scheme that describes the ontology's own
        vocabulary (e.g., reversibility tiers, grounding statuses, the
        Visibility scheme itself). Meta-schemes are exempt from the
        axisPosition / tier / groundedIn metadata invariant because
        they describe the framework, not project decisions."""@en ;
    rdfs:subClassOf skos:ConceptScheme .

spp:PlannedLink a owl:Class ;
    rdfs:label "Planned Link"@en ;
    rdfs:comment "A declared relationship between components."@en .

